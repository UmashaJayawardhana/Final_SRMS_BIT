@{
    ViewBag.Title = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width: 600px; margin: 80px auto; padding: 40px; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); text-align: center; font-family: 'Inter', sans-serif;">
    <div style="font-size: 72px; color: #ef4444; margin-bottom: 20px;">
        <ion-icon name="lock-closed-outline"></ion-icon>
    </div>
    <h2 style="color: #1e293b; font-size: 28px; font-weight: 700; margin-bottom: 12px;">Access Denied</h2>
    <p style="color: #64748b; font-size: 16px; line-height: 1.6; margin-bottom: 30px;">
        You do not have the required permissions to view this page. If you believe this is an error, please contact your system administrator.
    </p>
    <a href="/Home/DashBoard" style="display: inline-flex; align-items: center; gap: 8px; background-color: #3b82f6; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 6px; font-weight: 600; font-size: 15px; transition: all 0.2s ease;">
        <ion-icon name="arrow-back-outline"></ion-icon>
        Back to Dashboard
    </a>
</div>

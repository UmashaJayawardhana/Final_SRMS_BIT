@model List<MvcApplication1.Models.ClassSubjectTeacherModels>
@{
ViewBag.Title = "AddClassSubjectTeacher";
Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/StyleSheet3.css")" />

<style>
    /* Scoped styling for AddClassSubjectTeacher enhancements */

    /* Stats Cards */
    .stat-card {
    border-radius: 12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    background: #ffffff;
    border: 1px solid #e2e8f0;
}
.stat-card:hover {
transform: translateY(-2px);
box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02) !important;
}
.bg-primary-subtle {
background-color: rgba(59, 130, 246, 0.08) !important;
}
.bg-success-subtle {
background-color: rgba(34, 197, 94, 0.08) !important;
}

/* Overriding StyleSheet3.css styles for form alignment */
.addform .form-grid {
display: flex !important;
flex-direction: row !important;
flex-wrap: wrap;
gap: 20px;
margin-bottom: 0 !important;
}
.addform .form-grid > div {
display: flex !important;
flex-direction: column !important;
margin-bottom: 0 !important;
}

/* Table Search and Filters */
.filter-control:focus {
border-color: #3b82f6;
box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
outline: none;
}

/* Edit Mode dynamic classes */
.addform.editing-state {
border: 2px solid #8b5cf6 !important;
box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.15), 0 8px 10px -6px rgba(139, 92, 246, 0.08) !important;
}
.editing-row {
background-color: rgba(139, 92, 246, 0.06) !important;
border-left: 4px solid #8b5cf6 !important;
}
.editing-row td {
font-weight: 500;
color: #6d28d9 !important;
}

/* Row selection highlight */
.addtable tbody tr.table-active-row {
background-color: rgba(59, 130, 246, 0.08) !important;
border-left: 4px solid #3b82f6 !important;
}

/* Smooth transitions */
.addform, .addtable tr {
transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}
</style>

<!-- Metrics / Statistics Panel -->
<div class="row g-3 mb-4" style="max-width: 900px; margin: 0 auto 1.5rem auto;">
    <div class="col-md-6">
        <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
            <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-3 d-flex align-items-center justify-content-center" style="font-size: 24px; width: 56px; height: 56px;">
                <ion-icon name="ribbon-outline"></ion-icon>
            </div>
            <div>
                <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Total Assignments</h6>
                <h3 class="mb-0 fw-bold" id="statTotalAssignments" style="margin: 0;">0</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
            <div class="stat-icon bg-success-subtle text-success rounded-3 p-3 d-flex align-items-center justify-content-center" style="font-size: 24px; width: 56px; height: 56px;">
                <ion-icon name="checkmark-circle-outline"></ion-icon>
            </div>
            <div>
                <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Active Assignments</h6>
                <h3 class="mb-0 fw-bold" id="statActiveAssignments" style="margin: 0;">0</h3>
            </div>
        </div>
    </div>
</div>

<!-- Form -->
<form class="addform" id="AddClassSubjectTeacherForm" method="post" action="/Master/AddClassSubjectTeacher" enctype="multipart/form-data" style="max-width: 900px;">
    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
        <h4 id="formHeader" class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; width: 100%; border-bottom: none;">
            <span id="formHeaderEmoji">&#x2795;</span> <span id="formHeaderText">Assign Teachers to Subject - Class</span>
        </h4>
        <span id="formBadge" class="badge bg-purple text-white px-2 py-1" style="display: none; background-color: #8b5cf6; font-size: 11px; font-weight: 600; border-radius: 6px;">EDIT MODE</span>
    </div>

    <input type="hidden" id="classsubjectteacherSerial" name="ClassSubjectTeacherSerial" />

    <div class="form-grid">
        <!-- Year Selection -->
        <div style="flex: 1; min-width: 250px;">
            <label for="year" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Year:</label>
            @Html.DropDownList("Year", (SelectList)ViewBag.Years, "--Select Year--", new { @class = "form-control", style="width: 100%; height: 46px; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 16px; background-color: #f8fafc;", @id = "year", required = "required" })
        </div>

        <!-- Batch Selection -->
        <div style="flex: 1; min-width: 250px;">
            <label for="batchserial" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Batch:</label>
            <select id="batchserial" class="form-control" name="BatchSerial" required style="width: 100%; height: 46px; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 16px; background-color: #f8fafc;">
                <option value="">-- Select Batch --</option>
            </select>
        </div>

        <!-- Class Selection -->
        <div style="flex: 1; min-width: 250px;">
            <label for="classserial" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Class:</label>
            <select id="classserial" class="form-control" name="ClassSerial" required style="width: 100%; height: 46px; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 16px; background-color: #f8fafc;">
                <option value="">-- Select Class --</option>
            </select>
        </div>

        <!-- Subject Selection -->
        <div style="flex: 1; min-width: 250px;">
            <label for="subjectserial" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Subject:</label>
            <select id="subjectserial" class="form-control" name="SubjectSerial" required style="width: 100%; height: 46px; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 16px; background-color: #f8fafc;">
                <option value="">-- Select Subject --</option>
            </select>
        </div>

        <!-- Teacher Selection -->
        <div style="flex: 1; min-width: 250px;">
            <label for="teacherserial" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Teacher:</label>
            <select id="teacherserial" class="form-control" name="TeacherSerial" required style="width: 100%; height: 46px; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 16px; background-color: #f8fafc;">
                <option value="">-- Select Teacher --</option>
            </select>
        </div>

        <!-- Status -->
        <div style="flex: 1; min-width: 250px;">
            <label for="status" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Status:</label>
            <select id="status" class="form-control" name="Status" required style="width: 100%; height: 46px; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 16px; background-color: #f8fafc;">
                <option value="">-- Select Status --</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
    </div>

    <!-- Actions Buttons -->
    <div style="display: flex !important; flex-direction: row !important; gap: 12px; justify-content: center; margin-top: 24px;">
        <button type="submit" id="saveBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #3b82f6; color: white; border: none; cursor: pointer; min-width: 110px;">Save</button>
        <button type="button" id="cancelBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #ef4444 !important; color: white; border: none; cursor: pointer; min-width: 110px;" onclick="resetAssignmentForm();">Cancel</button>
        <button type="button" id="showListBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #10b981 !important; color: white; border: none; cursor: pointer; min-width: 110px;" onclick="toggleList();">Show List</button>
    </div>
</form>

<br />

<!-- Search and Filter Bar -->
<div class="addtable-container border-0 shadow-sm p-4 bg-white rounded-4" style="display: none; max-width: 900px; margin: 1.5rem auto 3rem auto;">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <h4 class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; border-bottom: none; width: auto;">
            <span style="font-size: 22px; margin-right: 2px;">&#x1F393;</span> Class - Subject - Teacher
        </h4>
        <!-- Force search controls to the right -->
        <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end" style="margin-left: auto;">
            <div class="position-relative flex-grow-1" style="max-width: 300px;">
                <ion-icon name="search-outline" class="position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); font-size: 18px;"></ion-icon>
                <input type="text" id="tableSearch" class="form-control filter-control ps-5" placeholder="Search Assignments..." style="height: 40px; font-size: 14px; border-radius: 8px;" />
            </div>
            <select id="statusFilter" class="form-select filter-control" style="width: 140px; height: 40px; font-size: 14px; border-radius: 8px;">
                <option value="All">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
    </div>

    <!-- Table -->
    <table class="table addtable align-middle" id="assignmentsTable" style="margin-bottom: 0 !important;">
        <thead>
            <tr>
                <th style="display:none;">Serial No</th>
                <th style="width: 60px;">No</th>
                <th>Year</th>
                <th style="display:none;">BatchSerial</th>
                <th>Batch Name</th>
                <th style="display:none;">ClassSerial</th>
                <th>Class Name</th>
                <th style="display:none;">SubjectSerial</th>
                <th>Subject Name</th>
                <th style="display:none;">TeacherSerial</th>
                <th>Teacher</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var classnew in Model)
                {
                    <tr onclick="fillForm(this)">
                        <td style="display:none;" class="col-serial">@classnew.ClassSubjectTeacherSerial</td>
                        <td class="col-no">@classnew.No</td>
                        <td class="col-year">@classnew.Year</td>
                        <td style="display:none;" class="col-batch-serial">@classnew.BatchSerial</td>
                        <td class="col-batch text-dark">@classnew.BatchName</td>
                        <td style="display:none;" class="col-class-serial">@classnew.ClassSerial</td>
                        <td class="col-class text-dark">@classnew.ClassName</td>
                        <td style="display:none;" class="col-subject-serial">@classnew.SubjectSerial</td>
                        <td class="col-subject fw-semibold text-dark">@classnew.SubjectName</td>
                        <td style="display:none;" class="col-teacher-serial">@classnew.TeacherSerial</td>
                        <td class="col-teacher text-muted">@classnew.FullName</td>
                        <td class="col-status">
                            @if (classnew.Status == "Active")
                            {
                                <span class="badge bg-success-subtle text-success px-2.5 py-1" style="font-size: 12px; border: 1px solid #bbf7d0; border-radius: 20px; display: inline-flex; align-items: center; gap: 4px;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #22c55e;"></span> Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1" style="font-size: 12px; border: 1px solid #cbd5e1; border-radius: 20px; display: inline-flex; align-items: center; gap: 4px;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #64748b;"></span> Inactive
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Empty State -->
    <div id="emptyState" class="text-center py-5 d-none">
        <ion-icon name="search-outline" class="text-muted mb-2" style="font-size: 40px; opacity: 0.5;"></ion-icon>
        <h5 class="text-muted fw-normal" style="font-size: 16px;">No matching assignments found</h5>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    // Stats calculation
    function calculateStats() {
    var rows = document.querySelectorAll("#assignmentsTable tbody tr");
    var totalAssignments = rows.length;
    var activeAssignments = 0;

    rows.forEach(function (row) {
    var statusText = row.querySelector(".col-status").innerText.trim().toLowerCase();
    if (statusText === "active") {
    activeAssignments++;
}
});

document.getElementById("statTotalAssignments").innerText = totalAssignments;
document.getElementById("statActiveAssignments").innerText = activeAssignments;
}

// Dynamic Cascading Dropdowns
function loadbatches(callback) {
var year = $('#year').val();
if (year) {
$.ajax({
url: '/Master/GetBatchesByYear',
type: 'GET',
data: { year: year },
success: function (data) {
var batchDropdown = $('#batchserial');
batchDropdown.empty().append('<option value="">-- Select Batch --</option>');
$.each(data, function (i, batch) {
batchDropdown.append('<option value="' + batch.Value + '">' + batch.Text + '</option>');
});
if (callback) callback();
},
error: function () {
alert('Failed to load batches.');
}
});
}
}

function loadClasses(callback) {
var batchSerial = $('#batchserial').val();
if (batchSerial) {
$.ajax({
url: '/Master/GetClassesByBatch',
type: 'GET',
data: { batchSerial: batchSerial },
success: function (data) {
var classDropdown = $('#classserial');
classDropdown.empty().append('<option value="">-- Select Class --</option>');
$.each(data, function (i, item) {
classDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
});
if (callback) callback();
}
});
}
}

function loadSubjects(callback) {
var batchSerial = $('#batchserial').val();
if (batchSerial) {
$.ajax({
url: '/Master/GetSubjectsByBatch',
type: 'GET',
data: { batchSerial: batchSerial },
success: function (data) {
var subjectDropdown = $('#subjectserial');
subjectDropdown.empty().append('<option value="">-- Select Subject --</option>');
$.each(data, function (i, item) {
subjectDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
});
if (callback) callback();
}
});
}
}

function loadTeachers(callback) {
var subjectserial = $('#subjectserial').val();
if (subjectserial) {
$.ajax({
url: '/Master/GetTeachersBySubject',
type: 'GET',
data: { subjectserial: subjectserial },
success: function (data) {
var teacherDropdown = $('#teacherserial');
teacherDropdown.empty().append('<option value="">-- Select Teacher --</option>');
$.each(data, function (i, item) {
teacherDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
});
if (callback) callback();
}
});
}
}

$(document).ready(function () {
calculateStats();

// Listeners for filter/search
$("#tableSearch").on("keyup input", filterTable);
$("#statusFilter").on("change", filterTable);

// Cascading event triggers
$('#year').change(function () {
loadbatches();
});

$('#batchserial').change(function () {
loadClasses();
loadSubjects();
});

$('#subjectserial').change(function () {
loadTeachers();
});

// Clean up alert banners after 3 seconds
setTimeout(function () {
$('.alert').fadeOut('slow');
}, 3000);

// Check for TempData message and show toast
@if (TempData["Message"] != null)
{
    <text>
        var toastLive = document.getElementById('liveToast');
        if (toastLive) {
        var toast = new bootstrap.Toast(toastLive);
        toast.show();
    }
</text>
}
});

// Search & Filter functionality
function filterTable() {
var searchQuery = $("#tableSearch").val().toLowerCase();
var statusFilter = $("#statusFilter").val();
var visibleRows = 0;

$("#assignmentsTable tbody tr").each(function () {
var row = $(this);
var yearText = row.find(".col-year").text().trim().toLowerCase();
var batchName = row.find(".col-batch").text().trim().toLowerCase();
var className = row.find(".col-class").text().trim().toLowerCase();
var subjectName = row.find(".col-subject").text().trim().toLowerCase();
var teacherName = row.find(".col-teacher").text().trim().toLowerCase();
var statusText = row.find(".col-status").text().trim().toLowerCase();
var isActive = (statusText === "active");

var matchesSearch = yearText.indexOf(searchQuery) > -1 ||
batchName.indexOf(searchQuery) > -1 ||
className.indexOf(searchQuery) > -1 ||
subjectName.indexOf(searchQuery) > -1 ||
teacherName.indexOf(searchQuery) > -1;
var matchesStatus = true;

if (statusFilter === "Active") {
matchesStatus = isActive;
}
else if (statusFilter === "Inactive")
{
    matchesStatus = !isActive;
}

if (matchesSearch && matchesStatus) {
row.removeClass("d-none");
visibleRows++;
}
else
{
    row.addClass("d-none");
}
});

if (visibleRows === 0) {
$("#emptyState").removeClass("d-none");
$("#assignmentsTable").addClass("d-none");
}
else
{
    $("#emptyState").addClass("d-none");
    $("#assignmentsTable").removeClass("d-none");
}
}

// Fill form helper (Edit mode trigger)
function fillForm(row) {
$("#assignmentsTable tbody tr").removeClass("editing-row table-active-row");
$(row).addClass("editing-row table-active-row");

var serial = $(row).find(".col-serial").text().trim();
var year = $(row).find(".col-year").text().trim();
var batchSerial = $(row).find(".col-batch-serial").text().trim();
var classSerial = $(row).find(".col-class-serial").text().trim();
var subjectSerial = $(row).find(".col-subject-serial").text().trim();
var teacherSerial = $(row).find(".col-teacher-serial").text().trim();
var status = $(row).find(".col-status").text().trim();
var subjectName = $(row).find(".col-subject").text().trim();

document.getElementById("classsubjectteacherSerial").value = serial;
document.getElementById("year").value = year;
document.getElementById("status").value = status;

// Load batches for year
$.get('/Master/GetBatchesByYear', { year: year }, function (batches) {
var $batchDropdown = $('#batchserial');
$batchDropdown.empty().append('<option value="">-- Select Batch --</option>');
$.each(batches, function (i, batch) {
$batchDropdown.append(`<option value="${batch.Value}">${batch.Text}</option>`);
});
$batchDropdown.val(batchSerial);

// Load classes for batch
$.get('/Master/GetClassesByBatch', { batchSerial: batchSerial }, function (classes) {
var $classDropdown = $('#classserial');
$classDropdown.empty().append('<option value="">-- Select Class --</option>');
$.each(classes, function (i, cls) {
$classDropdown.append(`<option value="${cls.Value}">${cls.Text}</option>`);
});
$classDropdown.val(classSerial);

// Load subjects for batch
$.get('/Master/GetSubjectsByBatch', { batchSerial: batchSerial }, function (subjects) {
var $subjectDropdown = $('#subjectserial');
$subjectDropdown.empty().append('<option value="">-- Select Subject --</option>');
$.each(subjects, function (i, sub) {
$subjectDropdown.append(`<option value="${sub.Value}">${sub.Text}</option>`);
});
$subjectDropdown.val(subjectSerial);

// Load teachers for subject
$.get('/Master/GetTeachersBySubject', { subjectserial: subjectSerial }, function (teachers) {
var $teacherDropdown = $('#teacherserial');
$teacherDropdown.empty().append('<option value="">-- Select Teacher --</option>');
$.each(teachers, function (i, tea) {
$teacherDropdown.append(`<option value="${tea.Value}">${tea.Text}</option>`);
});
$teacherDropdown.val(teacherSerial);
});
});
});
});

// Update UI to edit state
$("#AddClassSubjectTeacherForm").addClass("editing-state");
document.getElementById("formHeaderEmoji").innerHTML = "&#x270F;";
document.getElementById("formHeaderText").innerHTML = "Edit Assignment: " + subjectName;
$("#formBadge").fadeIn(200);

// Adjust update button look
$("#saveBtn").text("Update Assignment").css("background-color", "#8b5cf6").css("border-color", "#8b5cf6");

// Scroll form into view gently
document.getElementById("AddClassSubjectTeacherForm").scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

// Reset form dynamically without full page reload
function resetAssignmentForm() {
document.getElementById("classsubjectteacherSerial").value = "";
document.getElementById("AddClassSubjectTeacherForm").reset();

// Reset dynamic select inputs
$('#batchserial').empty().append('<option value="">-- Select Batch --</option>');
$('#classserial').empty().append('<option value="">-- Select Class --</option>');
$('#subjectserial').empty().append('<option value="">-- Select Subject --</option>');
$('#teacherserial').empty().append('<option value="">-- Select Teacher --</option>');

$("#assignmentsTable tbody tr").removeClass("editing-row table-active-row");
$("#AddClassSubjectTeacherForm").removeClass("editing-state");
document.getElementById("formHeaderEmoji").innerHTML = "&#x2795;";
document.getElementById("formHeaderText").innerHTML = "Assign Teachers to Subject - Class";
$("#formBadge").fadeOut(200);

// Reset button styling
$("#saveBtn").text("Save").css("background-color", "#3b82f6").css("border-color", "#3b82f6");
}

function toggleList() {
    var container = document.querySelector(".addtable-container");
    var btn = document.getElementById("showListBtn");
    if (container.style.display === "none" || container.style.display === "") {
        container.style.display = "block";
        btn.innerText = "Hide List";
    } else {
        container.style.display = "none";
        btn.innerText = "Show List";
    }
}
</script>
}
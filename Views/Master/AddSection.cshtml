@model List<MvcApplication1.Models.SectionModels>
@{
ViewBag.Title = "Section";
Layout = "~/Views/Shared/_Layout.cshtml";
var teachers = ViewBag.Teachers as List<MvcApplication1.Models.TeacherModels>;
}

<link rel="stylesheet" href="@Url.Content("~/Content/StyleSheet3.css")" />

<style>
    /* Scoped styling for AddSection enhancements */

    /* Stats Cards */
    .stat-card {
    border-radius: 12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    background: #ffffff;
    border: 1px solid #e2e8f0;
}
.stat-card:hover {
transform: translateY(-2px);
box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02) !important;
}
.bg-primary-subtle {
background-color: rgba(59, 130, 246, 0.08) !important;
}
.bg-success-subtle {
background-color: rgba(34, 197, 94, 0.08) !important;
}

/* Overriding StyleSheet3.css styles for form alignment */
.addform .form-grid {
display: flex !important;
flex-direction: row !important;
flex-wrap: wrap;
gap: 20px;
margin-bottom: 0 !important;
}
.addform .form-grid > div {
display: flex !important;
flex-direction: column !important;
margin-bottom: 0 !important;
}

/* Table Search and Filters */
.filter-control:focus {
border-color: #3b82f6;
box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
outline: none;
}

/* Edit Mode dynamic classes */
.addform.editing-state {
border: 2px solid #8b5cf6 !important;
box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.15), 0 8px 10px -6px rgba(139, 92, 246, 0.08) !important;
}
.editing-row {
background-color: rgba(139, 92, 246, 0.06) !important;
border-left: 4px solid #8b5cf6 !important;
}
.editing-row td {
font-weight: 500;
color: #6d28d9 !important;
}

/* Row selection highlight */
.addtable tbody tr.table-active-row {
background-color: rgba(59, 130, 246, 0.08) !important;
border-left: 4px solid #3b82f6 !important;
}

/* Smooth transitions */
.addform, .addtable tr {
transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}
</style>

<!-- Metrics / Statistics Panel -->
<div class="row g-3 mb-4" style="max-width: 900px; margin: 0 auto 1.5rem auto;">
    <div class="col-md-6">
        <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
            <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-3 d-flex align-items-center justify-content-center" style="font-size: 24px; width: 56px; height: 56px;">
                <ion-icon name="ribbon-outline"></ion-icon>
            </div>
            <div>
                <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Total Sections</h6>
                <h3 class="mb-0 fw-bold" id="statTotalSections" style="margin: 0;">0</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
            <div class="stat-icon bg-success-subtle text-success rounded-3 p-3 d-flex align-items-center justify-content-center" style="font-size: 24px; width: 56px; height: 56px;">
                <ion-icon name="checkmark-circle-outline"></ion-icon>
            </div>
            <div>
                <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Active Sections</h6>
                <h3 class="mb-0 fw-bold" id="statActiveSections" style="margin: 0;">0</h3>
            </div>
        </div>
    </div>
</div>

@if (teachers == null)
{
    <div class="alert alert-warning" role="alert" style="max-width: 900px; margin: 10px auto;">
        No teachers available
    </div>
}

<!-- Form -->
<form class="addform" id="addSectionForm" method="post" action="/Master/AddSection" style="max-width: 900px;">
    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
        <h4 id="formHeader" class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; width: 100%; border-bottom: none;">
            <span id="formHeaderEmoji">&#x2795;</span> <span id="formHeaderText">Add New Section</span>
        </h4>
        <span id="formBadge" class="badge bg-purple text-white px-2 py-1" style="display: none; background-color: #8b5cf6; font-size: 11px; font-weight: 600; border-radius: 6px;">EDIT MODE</span>
    </div>

    <input type="hidden" id="sectionserial" name="SectionSerial" />

    <div class="form-grid">
        <!-- Year Selection -->
        <div style="flex: 1; min-width: 250px;">
            <label for="year" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Year:</label>
            @Html.DropDownList("Year", (SelectList)ViewBag.Years, "--Select Year--", new { @class = "form-control", style="width: 100%; height: 46px; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 16px; background-color: #f8fafc;", @id = "year", required = "required" })
        </div>

        <!-- Section Name Selection -->
        <div style="flex: 1; min-width: 250px;">
            <label for="sectionname" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Section Name:</label>
            <select id="sectionname" name="SectionName" required style="width: 100%; height: 46px; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 16px; background-color: #f8fafc;">
                <option value="">--Select Section--</option>
                <option value="1-2">1-2</option>
                <option value="3-5">3-5</option>
            </select>
        </div>

        <!-- Status Selection -->
        <div style="flex: 1; min-width: 250px;">
            <label for="status" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Status:</label>
            <select id="status" name="Status" required style="width: 100%; height: 46px; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 16px; background-color: #f8fafc;">
                <option value="">--Select Status--</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>

        <!-- Section Head Selection -->
        <div style="flex: 1; min-width: 250px;">
            <label for="headteacher" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Section Head:</label>
            <select id="headteacher" name="TeacherSerial" required style="width: 100%; height: 46px; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 16px; background-color: #f8fafc;">
                <option value="">-- Select Teacher --</option>
                @if (teachers != null)
                {
                    foreach (var teacher in teachers)
                    {
                        <option value="@teacher.TeacherSerial">@teacher.FullName</option>
                    }
                }
            </select>
        </div>

    </div>

    <!-- Batch Selection with Add Button (below Section Head) -->
    <div style="margin-top: 20px; max-width: 520px;">
        <label for="batchserial" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Batch:</label>
        <div class="d-flex gap-2" style="display: flex !important; gap: 8px;">
            @Html.DropDownList("BatchSerial", (SelectList)ViewBag.Batches, "--Select Batch--", new { @class = "form-control", style="flex: 1; height: 46px; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 16px; background-color: #f8fafc;", @id = "batchserial"})
            <button type="button" class="btn btn-warning" onclick="addBatchToGrid()" style="height: 46px; width: 90px; border-radius: 10px; font-weight: 600; font-size: 14px; background-color: #f59e0b; color: white; border: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s ease; box-shadow: 0 4px 6px -1px rgba(245, 158, 11, 0.2);">
                <span id="formHeaderEmoji">&#x2795;</span> Add
            </button>
        </div>
    </div>

    <!-- Selected Batches Table -->
    <div class="mt-4 mb-4" style="max-width: 100%; margin-top: 24px; margin-bottom: 24px;">
        <label style="font-weight: 600; color: #475569; margin-bottom: 10px; display: block;">Selected Batches (Max 2):</label>
        <table class="table addtable align-middle" id="BatchTable" style="margin-bottom: 0 !important; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden;">
            <thead>
                <tr>
                    <th>Batch Name</th>
                    <th style="width: 120px; text-align: center;">Remove</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

    <!-- Hidden input container to collect BatchSerials -->
    <div id="BatchHiddenInputs"></div>

    <!-- Actions Buttons -->
    <div style="display: flex !important; flex-direction: row !important; gap: 12px; justify-content: center; margin-top: 24px;">
        <button type="submit" id="saveBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #3b82f6; color: white; border: none; cursor: pointer; min-width: 110px;">Save</button>
        <button type="button" id="cancelBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #ef4444 !important; color: white; border: none; cursor: pointer; min-width: 110px;" onclick="resetSectionForm();">Cancel</button>
        <button type="button" id="showListBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #10b981 !important; color: white; border: none; cursor: pointer; min-width: 110px;" onclick="toggleList();">Show List</button>
    </div>
</form>

<br />

<!-- Search and Filter Bar -->
<div class="addtable-container border-0 shadow-sm p-4 bg-white rounded-4" style="display: none; max-width: 900px; margin: 1.5rem auto 3rem auto;">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <h4 class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; border-bottom: none; width: auto;">
            <span style="font-size: 22px; margin-right: 2px;">&#x1F393;</span> Section
        </h4>
        <!-- Force search controls to the right -->
        <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end" style="margin-left: auto;">
            <div class="position-relative flex-grow-1" style="max-width: 300px;">
                <ion-icon name="search-outline" class="position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); font-size: 18px;"></ion-icon>
                <input type="text" id="tableSearch" class="form-control filter-control ps-5" placeholder="Search Sections..." style="height: 40px; font-size: 14px; border-radius: 8px;" />
            </div>
            <select id="statusFilter" class="form-select filter-control" style="width: 140px; height: 40px; font-size: 14px; border-radius: 8px;">
                <option value="All">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
    </div>

    <!-- Table -->
    <table class="table addtable align-middle" id="sectionsTable" style="margin-bottom: 0 !important;">
        <thead>
            <tr>
                <th style="display: none;">Serial No</th>
                <th style="width: 60px;">No</th>
                <th>Section Name</th>
                <th>Year</th>
                <th style="display:none;">TeacherSerial</th>
                <th>Section Head</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var sectionnew in Model)
                {
                    <tr onclick="fillForm(this)">
                        <td style="display: none;" class="col-serial">@sectionnew.SectionSerial</td>
                        <td class="col-no">@sectionnew.No</td>
                        <td class="col-name fw-semibold text-dark">@sectionnew.SectionName</td>
                        <td class="col-year">@sectionnew.Year</td>
                        <td style="display:none;" class="col-teacher-serial">@sectionnew.TeacherSerial</td>
                        <td class="col-teacher text-muted">@sectionnew.FullName</td>
                        <td class="col-status">
                            @if (sectionnew.Status == "Active")
                            {
                                <span class="badge bg-success-subtle text-success px-2.5 py-1" style="font-size: 12px; border: 1px solid #bbf7d0; border-radius: 20px; display: inline-flex; align-items: center; gap: 4px;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #22c55e;"></span> Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1" style="font-size: 12px; border: 1px solid #cbd5e1; border-radius: 20px; display: inline-flex; align-items: center; gap: 4px;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #64748b;"></span> Inactive
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Empty State -->
    <div id="emptyState" class="text-center py-5 d-none">
        <ion-icon name="search-outline" class="text-muted mb-2" style="font-size: 40px; opacity: 0.5;"></ion-icon>
        <h5 class="text-muted fw-normal" style="font-size: 16px;">No matching sections found</h5>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    // Stats calculation
    function calculateStats() {
    var rows = document.querySelectorAll("#sectionsTable tbody tr");
    var totalSections = rows.length;
    var activeSections = 0;

    rows.forEach(function (row) {
    var statusText = row.querySelector(".col-status").innerText.trim().toLowerCase();
    if (statusText === "active") {
    activeSections++;
}
});

document.getElementById("statTotalSections").innerText = totalSections;
document.getElementById("statActiveSections").innerText = activeSections;
}

// Load batches by year
function loadbatches(year, callback) {
if (year) {
$.ajax({
url: '/Master/GetBatchesByYear',
type: 'GET',
data: { year: year },
success: function (data) {
var batchDropdown = $('#batchserial');
batchDropdown.empty();
batchDropdown.append('<option value="">-- Select Batch --</option>');
$.each(data, function (i, batch) {
batchDropdown.append('<option value="' + batch.Value + '">' + batch.Text + '</option>');
});
if (typeof callback === 'function') callback();
},
error: function () {
alert('Failed to load batches.');
}
});
}
}

$(document).ready(function () {
calculateStats();

// Listeners for filter/search
$("#tableSearch").on("keyup input", filterTable);
$("#statusFilter").on("change", filterTable);

// Year change to load batches
$('#year').change(function () {
var selectedYear = $(this).val();
loadbatches(selectedYear);
});

// Form submission validation
$("#addSectionForm").on("submit", function (e) {
    var batchCount = $("#BatchHiddenInputs input[name='BatchSerials']").length;
    if (batchCount === 0) {
        alert("Please add at least one batch to the list.");
        e.preventDefault();
        return false;
    }
});

// Clean up alert banners after 3 seconds
setTimeout(function () {
$('.alert').fadeOut('slow');
}, 3000);

// Check for TempData message and show toast
@if (TempData["Message"] != null)
{
    <text>
        var toastLive = document.getElementById('liveToast');
        if (toastLive) {
        var toast = new bootstrap.Toast(toastLive);
        toast.show();
    }
</text>
}
});

// Search & Filter functionality
function filterTable() {
var searchQuery = $("#tableSearch").val().toLowerCase();
var statusFilter = $("#statusFilter").val();
var visibleRows = 0;

$("#sectionsTable tbody tr").each(function () {
var row = $(this);
var sectionName = row.find(".col-name").text().trim().toLowerCase();
var yearText = row.find(".col-year").text().trim().toLowerCase();
var teacherName = row.find(".col-teacher").text().trim().toLowerCase();
var statusText = row.find(".col-status").text().trim().toLowerCase();
var isActive = (statusText === "active");

var matchesSearch = sectionName.indexOf(searchQuery) > -1 ||
yearText.indexOf(searchQuery) > -1 ||
teacherName.indexOf(searchQuery) > -1;
var matchesStatus = true;

if (statusFilter === "Active") {
matchesStatus = isActive;
}
else if (statusFilter === "Inactive")
{
    matchesStatus = !isActive;
}

if (matchesSearch && matchesStatus) {
row.removeClass("d-none");
visibleRows++;
}
else
{
    row.addClass("d-none");
}
});

if (visibleRows === 0) {
$("#emptyState").removeClass("d-none");
$("#sectionsTable").addClass("d-none");
}
else
{
    $("#emptyState").addClass("d-none");
    $("#sectionsTable").removeClass("d-none");
}
}

// Fill form helper (Edit mode trigger)
function fillForm(row) {
// Remove highlight from other rows
$("#sectionsTable tbody tr").removeClass("editing-row table-active-row");
$(row).addClass("editing-row table-active-row");

var sectionSerial = $(row).find(".col-serial").text().trim();
var sectionName = $(row).find(".col-name").text().trim();
var year = $(row).find(".col-year").text().trim();
var status = $(row).find(".col-status").text().trim();
var head = $(row).find(".col-teacher-serial").text().trim();

document.getElementById("sectionserial").value = sectionSerial;
document.getElementById("sectionname").value = sectionName;
document.getElementById("year").value = year;
document.getElementById("status").value = status;
document.getElementById("headteacher").value = head;

// Clear existing batches in grid
document.querySelector("#BatchTable tbody").innerHTML = "";
document.getElementById("BatchHiddenInputs").innerHTML = "";

// Load batches dropdown based on year before filling table
loadbatches(year, function() {
// Fetch section details via AJAX
fetch(`/Master/GetSectionDetails?sectionSerial=${sectionSerial}`)
.then(response => response.json())
.then(data => {
data.forEach(g => {
const batchId = g.BatchSerial;
const batchName = g.BatchName;

const tableBody = document.getElementById("BatchTable").getElementsByTagName("tbody")[0];
const newRow = document.createElement("tr");
newRow.id = "batchRow_" + batchId;
newRow.innerHTML = `
<td class="fw-semibold text-dark">${batchName}</td>
<td style="text-align: center;">
    <button type="button" onclick="removeBatch(${batchId})" class="btn btn-sm btn-danger d-inline-flex align-items-center justify-content-center" style="height: 30px; padding: 0 12px; font-size: 12px; font-weight: 600; border-radius: 6px; background-color: #ef4444; color: white; border: none; cursor: pointer; transition: all 0.2s ease;">
        Remove
    </button>
</td>
`;
tableBody.appendChild(newRow);

const hiddenInput = document.createElement("input");
hiddenInput.type = "hidden";
hiddenInput.name = "BatchSerials";
hiddenInput.value = batchId;
hiddenInput.id = "batchInput_" + batchId;
document.getElementById("BatchHiddenInputs").appendChild(hiddenInput);
});
});
});

// Update UI to edit state
$("#addSectionForm").addClass("editing-state");
document.getElementById("formHeaderEmoji").innerHTML = "&#x270F;";
document.getElementById("formHeaderText").innerHTML = "Edit Section: " + sectionName;
$("#formBadge").fadeIn(200);

// Adjust update button look
$("#saveBtn").text("Update Section").css("background-color", "#8b5cf6").css("border-color", "#8b5cf6");

// Scroll form into view gently
document.getElementById("addSectionForm").scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

// Reset form dynamically without full page reload
function resetSectionForm() {
document.getElementById("sectionserial").value = "";
document.getElementById("addSectionForm").reset();
document.querySelector("#BatchTable tbody").innerHTML = "";
document.getElementById("BatchHiddenInputs").innerHTML = "";

$("#sectionsTable tbody tr").removeClass("editing-row table-active-row");
$("#addSectionForm").removeClass("editing-state");
document.getElementById("formHeaderEmoji").innerHTML = "&#x2795;";
document.getElementById("formHeaderText").innerHTML = "Add New Section";
$("#formBadge").fadeOut(200);

$("#saveBtn").text("Save").css("background-color", "#3b82f6").css("border-color", "#3b82f6");
}

// Add batch to grid
function addBatchToGrid() {
const dropdown = document.getElementById("batchserial");
const selectedValue = dropdown.value;
const selectedText = dropdown.options[dropdown.selectedIndex].text;

if (!selectedValue) {
alert("Please select a batch before adding to the list.");
return;
}

// Prevent duplicate
if (document.getElementById("batchRow_" + selectedValue)) {
alert("Batch is already existing");
return;
}

const tableBody = document.getElementById("BatchTable").getElementsByTagName("tbody")[0];
const currentBatchCount = tableBody.getElementsByTagName("tr").length;

if (currentBatchCount >= 2) {
alert("You can add only two batches to the list.");
return;
}

// Add to table
const newRow = document.createElement("tr");
newRow.id = "batchRow_" + selectedValue;
newRow.innerHTML = `
<td class="fw-semibold text-dark">${selectedText}</td>
<td style="text-align: center;">
    <button type="button" onclick="removeBatch(${selectedValue})" class="btn btn-sm btn-danger d-inline-flex align-items-center justify-content-center" style="height: 30px; padding: 0 12px; font-size: 12px; font-weight: 600; border-radius: 6px; background-color: #ef4444; color: white; border: none; cursor: pointer; transition: all 0.2s ease;">
        Remove
    </button>
</td>
`;
tableBody.appendChild(newRow);

// Add hidden input for form submission
const hiddenInput = document.createElement("input");
hiddenInput.type = "hidden";
hiddenInput.name = "BatchSerials";
hiddenInput.value = selectedValue;
hiddenInput.id = "batchInput_" + selectedValue;
document.getElementById("BatchHiddenInputs").appendChild(hiddenInput);
}

// Remove batch from grid
function removeBatch(batchId) {
// Remove row
const row = document.getElementById("batchRow_" + batchId);
if (row) row.remove();

// Remove hidden input
const input = document.getElementById("batchInput_" + batchId);
if (input) input.remove();
}

function toggleList() {
var container = document.querySelector(".addtable-container");
var btn = document.getElementById("showListBtn");
if (container.style.display === "none" || container.style.display === "") {
container.style.display = "block";
btn.innerText = "Hide List";
}
else
{
    container.style.display = "none";
    btn.innerText = "Show List";
}
}
</script>
}
function formatDate(dotNetDateString) {
if (!dotNetDateString) return "";
const timestamp = parseInt(dotNetDateString.replace(/\/Date\((\d+)\)\//, "$1"));
const date = new Date(timestamp);
return date.toISOString().split('T')[0]; // yyyy-MM-dd
}

// Retrieve student details for reg no
function loadStudentDetails(regNo) {
if (!regNo) return;

fetch(`/Student/LookupStudent?regNo=${regNo}`)
.then(res => res.json())
.then(data => {
console.log("Student data:", data);

// Fill basic fields
$("#studentserial").val(data.StudentSerial);
$("#regno").val(data.RegNo);
$("#firstname").val(data.FirstName);
$("#fullname").val(data.FullName);
$("#gender").val(data.Gender);
$("#initials").val(data.Initials);
$("#lastname").val(data.LastName);
$("#dateofbirth").val(formatDate(data.DateofBirth));
$("#admissiondate").val(formatDate(data.AdmissionDate));
$("#address1").val(data.Address1);
$("#address2").val(data.Address2);
$("#address3").val(data.Address3);
$("#city").val(data.City);
$("#residencephone").val(data.ResidencePhone);
$("#guardianname").val(data.GuardianName);
$("#guardianphone").val(data.GuardianPhone);
$("#guardiantype").val(data.GuardianType);
$("#status").val(data.Status);
$("#yearDropdown").val(data.Year);

// Set image
if (data.LookupPhoto) {
$("#studentImage").attr("src", data.LookupPhoto).show();
}
else
{
    $("#studentImage").attr("src", "/Content/img/profileimg.png").show();
}

// Load batches for year
$.get('/Student/GetBatchesByYear', { year: data.Year }, function (batches) {
var $batchDropdown = $('#batchserial');
$batchDropdown.empty().append('<option value="">-- Select Batch --</option>');
$.each(batches, function (i, batch) {
$batchDropdown.append(`<option value="${batch.Value}">${batch.Text}</option>`);
});

// Set batch value
$batchDropdown.val(data.BatchSerial);

// Load classes for batch
$.get('/Student/GetClassesByBatch', { batchSerial: data.BatchSerial }, function (classes) {
var $classDropdown = $('#classserial');
$classDropdown.empty().append('<option value="">-- Select Class --</option>');
$.each(classes, function (i, cls) {
$classDropdown.append(`<option value="${cls.Value}">${cls.Text}</option>`);
});

// Set class value
$classDropdown.val(data.ClassSerial);
});
});
});
}
</script>
}
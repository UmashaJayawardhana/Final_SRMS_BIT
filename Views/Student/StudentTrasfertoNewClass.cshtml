@{
ViewBag.Title = "StudentTrasfertoNewClass";
Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- StudentTrasfertoNewClass.cshtml content -->



<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- CSS -->
<link rel="stylesheet" href="@Url.Content("~/Content/StyleSheet4.css")" />






@model List<MvcApplication1.Models.StudentTrasfertoNewClassModels>
@{

}



<!-- Form -->
<div class="container d-flex flex-column align-items-center">
    <h4 style="justify-content: center; text-align: center; max-width: 600px; width: 100%; margin: 1.5rem auto 10px auto; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px;"><span id="formHeaderEmoji"></span> Student Transfer to New Class</h4>
    @using (Html.BeginForm("StudentTrasfertoNewClass", "Student", FormMethod.Post, new { enctype = "multipart/form-data", @class = "addform", id = "StudentTrasfertoNewClassform", onsubmit = "return validateDates();", style = "max-width: 600px; margin: 0 auto; width: 100%; display: flex; flex-direction: column; gap: 15px;" }))
    {
        <!-- Form contents here -->
        <div class="d-flex flex-column gap-1">
            <label for="year" style="font-weight: 600; color: #475569;">Year:</label>
            @Html.DropDownList("Year",(SelectList)ViewBag.Years, "--Select Year--", new { @class = "form-control", @id = "year",  required = "required" })
        </div>

        <div class="d-flex flex-column gap-1">
            <label for="batchserial" style="font-weight: 600; color: #475569;">Batch:</label>
            <select id="batchserial" class="form-control" name="BatchSerial" required>
                <option value="">-- Select Batch --</option>
            </select>
        </div>

        <div class="d-flex flex-column gap-1">
            <label for="Prevclasssserial" style="font-weight: 600; color: #475569;">Class:</label>
            <select id="Prevclasssserial" class="form-control" name="PrevClassSerial" required>
                <option value="">-- Select Class --</option>
            </select>
        </div>

        <div class="d-flex flex-column gap-1">
            <label for="studentSerial" style="font-weight: 600; color: #475569;">Student:</label>
            @Html.DropDownList("StudentSerial", (SelectList)ViewBag.Students, "--Select Student--", new { @class = "form-control", @id = "studentSerial", required = "required" })
        </div>

        <div class="d-flex flex-column gap-1">
            <label for="Newclasssserial" style="font-weight: 600; color: #475569;">New Class:</label>
            <select id="Newclasssserial" class="form-control" name="NewClassSerial" required>
                <option value="">-- Select Class --</option>
            </select>
        </div>

        <div class="d-flex flex-column gap-1">
            <label for="transferDate" style="font-weight: 600; color: #475569;">Transfer Date:</label>
            <input type="date" id="transferDate" name="TransferDate" required class="form-control">
        </div>

        <div class="d-flex flex-column gap-1">
            <label for="transferReason" style="font-weight: 600; color: #475569;">Reason:</label>
            <input type="text" id="transferReason" name="TransferReason" required class="form-control" placeholder="Reason for transfer">
        </div>

        <div class="form-group text-center mt-4" style="display: flex !important; flex-direction: row !important; justify-content: center !important; gap: 12px; margin-top: 24px;">
            <button type="submit" class="btn btn-success" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #10b981; color: white; border: none; cursor: pointer; min-width: 110px;">Transfer</button>
            <button type="button" id="toggleListBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #0f172a; color: white; border: none; cursor: pointer; min-width: 110px;" onclick="toggleStudentList()">Show List</button>
            <button type="button" class="btn btn-danger" onclick="location.reload();" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #ef4444 !important; color: white; border: none; cursor: pointer; min-width: 110px;">Cancel</button>
        </div>
    }
</div>

<br />

<!-- Search and Filter Bar Container (Collapsible) -->
<div id="studentsTableContainer" class="d-none">
    <div class="addtable-container border-0 shadow-sm p-4 bg-white rounded-4" style="max-width: 900px; margin: 1.5rem auto 3rem auto;">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
            <h4 class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; border-bottom: none; width: auto; margin: 0;">
                <span style="font-size: 22px; margin-right: 2px;">&#x1F393;</span> Transfer Student List
            </h4>
            <!-- Force search controls to the right -->
            <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end" style="margin-left: auto;">
                <div class="position-relative flex-grow-1" style="max-width: 300px;">
                    <ion-icon name="search-outline" class="position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); font-size: 18px;"></ion-icon>
                    <input type="text" id="tableSearch" class="form-control filter-control ps-5" placeholder="Search Transfers..." style="height: 40px; font-size: 14px; border-radius: 8px;" />
                </div>
                <select id="yearFilter" class="form-select filter-control" style="width: 140px; height: 40px; font-size: 14px; border-radius: 8px;">
                    <option value="All">All Years</option>
                    @if (ViewBag.Years != null)
                    {
                        foreach (var yr in ViewBag.Years as SelectList)
                        {
                            <option value="@yr.Value">@yr.Text</option>
                        }
                    }
                </select>
            </div>
        </div>

        <!-- Table -->
        <table class="table addtable align-middle" id="studentsTable" style="margin-bottom: 0 !important; width: 100%;">
            <thead>
                <tr>
                    <th style="width: 60px;">No</th>
                    <th>Reg No</th>
                    <th>Student Name</th>
                    <th>Year</th>
                    <th>Batch</th>
                    <th>New Class</th>
                    <th>Transfer Date</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var trans in Model)
                    {
                        <tr>
                            <td class="col-no">@trans.No</td>
                            <td class="col-regno fw-semibold text-dark">@trans.RegNo</td>
                            <td class="col-fullname">@trans.FullName</td>
                            <td class="col-year">@trans.Year</td>
                            <td class="col-batch">@trans.BatchName</td>
                            <td class="col-class">@trans.ClassName</td>
                            <td class="col-date">@trans.TransferDate.ToString("yyyy-MM-dd")</td>
                            <td class="col-reason">@trans.TransferReason</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <!-- Empty State -->
        <div id="emptyState" class="text-center py-5 d-none">
            <ion-icon name="search-outline" class="text-muted mb-2" style="font-size: 40px; opacity: 0.5;"></ion-icon>
            <h5 class="text-muted fw-normal" style="font-size: 16px;">No matching transfers found</h5>
        </div>
    </div>
</div>
@if (TempData["Message"] != null)
{
    <script>
        window.onload = function () {
        var toastLive = document.getElementById('liveToast');
        var toast = new bootstrap.Toast(toastLive);
        toast.show();
        };
    </script>
}

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        $('#formHeaderEmoji').html('&#x2795;');

        // Set up search and filter listeners
        $("#tableSearch").on("keyup input", filterTable);
        $("#yearFilter").on("change", filterTable);

    // log and bind year change
    $('#year').change(function () {
    console.log("Year changed to:", $(this).val());
    loadbatches();
    });

    $('#batchserial').change(function () {
    loadClasses();
    });

    $('#batchserial').change(function () {
    loadnewClasses();
    });

    //load  batches
    function loadbatches() {
    var year = $('#year').val();

    if (year) {
    $.ajax({
    url: '/Student/GetBatchesByYear',
    type: 'GET',
    data: { year: year },
    success: function (data) {
    console.log("Batches received:", data); // debug
    var batchDropdown = $('#batchserial');
    batchDropdown.empty();
    batchDropdown.append('<option value="">-- Select Batch --</option>');
    $.each(data, function (i, batch) {
    batchDropdown.append('<option value="' + batch.Value + '">' + batch.Text + '</option>');
    });
    },
    error: function (xhr, status, error) {
    console.error("Error loading batches:", error);
    alert('Failed to load batches.');
}
});
}
}


//load previous classes
function loadClasses() {
var batchSerial = $('#batchserial').val();

if (batchSerial) {
$.ajax({
url: '/Student/GetClassesByBatch',
type: 'GET',
data: { batchSerial: batchSerial },
success: function (data) {
var classDropdown = $('#Prevclasssserial');
classDropdown.empty().append('<option value="">-- Select Class --</option>');
$.each(data, function (i, item) {
classDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
});
}
});
}
}

//load new classess
function loadnewClasses() {
var batchSerial = $('#batchserial').val();

if (batchSerial) {
$.ajax({
url: '/Student/GetClassesByBatch',
type: 'GET',
data: { batchSerial: batchSerial },
success: function (data) {
var classDropdown = $('#Newclasssserial');
classDropdown.empty().append('<option value="">-- Select Class --</option>');
$.each(data, function (i, item) {
classDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
});
}
});
}
}
});
</script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    function loadStudents() {
    var year = $('#year').val();
    var batchSerial = $('#batchserial').val();
    var classSerial = $('#Prevclasssserial').val();

    if (year && batchSerial && classSerial) {
    $.ajax({
    url: '/Student/GetStudentsByYearBatchClass',
    type: 'GET',
    data: {
    year: year,
    batchSerial: batchSerial,
    classSerial: classSerial
    },
    success: function (data) {
    var studentDropdown = $('#studentSerial');
    studentDropdown.empty();
    studentDropdown.append('<option value="">--Select Student--</option>');
    $.each(data, function (i, student) {
    studentDropdown.append('<option value="' + student.Value + '">' + student.Text + '</option>');
    });
    },
    error: function () {
    alert('Failed to load students.');
}
});
}
}

// Trigger when any dropdown changes
$('#year, #batchserial, #Prevclasssserial').change(function () {
loadStudents();
});
</script>
}

<script>
    function validateDates() {
    var today = new Date().toISOString().split("T")[0];

    var transferDate = document.getElementById("transferDate").value;



    if (transferDate > today) {
    alert("Transfer Date cannot be in the future.");
    return false;
}

return true;
}

// Toggle Student Table List visibility
function toggleStudentList() {
    var container = $("#studentsTableContainer");
    var btn = $("#toggleListBtn");
    if (container.hasClass("d-none")) {
        container.removeClass("d-none");
        btn.text("Hide List").css("background-color", "#475569");
        container[0].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
        container.addClass("d-none");
        btn.text("Show List").css("background-color", "#0f172a");
    }
}

// Search & Filter functionality
function filterTable() {
    var searchQuery = $("#tableSearch").val().toLowerCase();
    var yearFilter = $("#yearFilter").val();
    var visibleRows = 0;

    $("#studentsTable tbody tr").each(function () {
        var row = $(this);
        var regNo = row.find(".col-regno").text().trim().toLowerCase();
        var fullName = row.find(".col-fullname").text().trim().toLowerCase();
        var className = row.find(".col-class").text().trim().toLowerCase();
        var batchName = row.find(".col-batch").text().trim().toLowerCase();
        var yearText = row.find(".col-year").text().trim().toLowerCase();
        var reasonText = row.find(".col-reason").text().trim().toLowerCase();

        var matchesSearch = regNo.indexOf(searchQuery) > -1 ||
            fullName.indexOf(searchQuery) > -1 ||
            className.indexOf(searchQuery) > -1 ||
            batchName.indexOf(searchQuery) > -1 ||
            yearText.indexOf(searchQuery) > -1 ||
            reasonText.indexOf(searchQuery) > -1;

        var matchesYear = (yearFilter === "All" || yearText === yearFilter.toLowerCase());

        if (matchesSearch && matchesYear) {
            row.removeClass("d-none");
            visibleRows++;
        } else {
            row.addClass("d-none");
        }
    });

    if (visibleRows === 0) {
        $("#emptyState").removeClass("d-none");
        $("#studentsTable").addClass("d-none");
    } else {
        $("#emptyState").addClass("d-none");
        $("#studentsTable").removeClass("d-none");
    }
}
</script>


<script>
    setTimeout(function () {
    const alert = document.querySelector('.alert');
    if (alert) {
    alert.style.display = 'none';
}
}, 3000); // Hide after 3 seconds
</script>
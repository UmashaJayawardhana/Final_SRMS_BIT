@{
    ViewBag.Title = "SubjectRangeReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- SubjectRangeReport.cshtml content -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/StyleSheet4.css")" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.20/dist/sweetalert2.min.css">
    <title>SubjectRangeReport</title>

</head>
<body>
    
<style>
    .inline-form-row {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        align-items: flex-end !important;
        gap: 12px !important;
        margin-bottom: 1.5rem;
        width: 100%;
    }
    .inline-form-row > div {
        flex: 1 1 150px !important;
        display: flex !important;
        flex-direction: column !important;
        margin-bottom: 0 !important;
    }
    .inline-form-row .button-group-inline {
        flex: 0 0 auto !important;
        display: flex !important;
        flex-direction: row !important;
        gap: 10px !important;
        align-items: center !important;
    }
    .btn-search {
        background-color: #22c55e !important;
        color: white !important;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        box-shadow: 0 4px 6px -1px rgba(34, 197, 94, 0.2) !important;
    }
    .btn-search:hover {
        background-color: #16a34a !important;
        box-shadow: 0 10px 15px -3px rgba(34, 197, 94, 0.3) !important;
    }
    .btn-cancel {
        background-color: #ef4444 !important;
        color: white !important;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        box-shadow: 0 4px 6px -1px rgba(239, 68, 68, 0.2) !important;
    }
    .btn-cancel:hover {
        background-color: #dc2626 !important;
        box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.3) !important;
    }
    .btn-download {
        background-color: #3b82f6 !important;
        color: white !important;
        border: none !important;
        padding: 10px 40px !important;
        border-radius: 4px !important;
        box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.2) !important;
        width: 200px !important;
        min-width: 150px !important;
        display: block !important;
        font-weight: 500;
        margin: 0 auto !important;
        transition: all 0.2s ease-in-out;
    }
    .btn-download:hover {
        background-color: #2563eb !important;
        box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3) !important;
        transform: translateY(-1px);
    }
</style>
      
    @model List<MvcApplication1.Models.ResultReportModels>
    @{
        
        var terms = ViewBag.Terms as List<MvcApplication1.Models.TermModels>;
    }
    
    <!-- Form -->
    <div class="container mt-4">
        <div class="card shadow-sm">
            <div class="card-header text-white" style="background: linear-gradient(135deg, #2c3e50, #3498db);">
                <h4 class="mb-0"><i class="fas fa-list-alt"></i> Subject Marks Range Report</h4>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("SubjectRangeReport", "Analyze", FormMethod.Post, new { enctype = "multipart/form-data", @class = "addform", id = "SubjectRangeReportForm" }))
                {
                    <input type="hidden" id="examresultserial" name="ExamResultSerial" />
                    
                    <div class="inline-form-row">
                        <div>
                            <label for="yearlabel">Year:</label>
                            @Html.DropDownList("Year",(SelectList)ViewBag.Years, "--Select Year--", new { @class = "form-control", @id = "year",  required = "required" })
                        </div>
                        <div>
                            <label for="batchDropdown">Batch:</label>
                            <select id="batchserial" class="form-control" name="BatchSerial" required>
                                <option value="">-- Select Batch --</option>
                            </select>
                        </div>
                        <div>
                            <label for="classDropdown">Class:</label>
                            <select id="classserial" class="form-control" name="ClassSerial" required>
                                <option value="">-- Select Class --</option>
                            </select>
                        </div>
                        <div>
                            <label for="termDropdown">Term:</label>
                            <select id="termserial" class="form-control" name="TermSerial" required>
                                <option value="">-- Select Term --</option>
                                @foreach (var term in terms)
                                {
                                    <option value="@term.TermSerial">@term.TermName</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label for="subjectDropdown">Subject:</label>
                            <select id="subjectserial" class="form-control" name="SubjectSerial" required>
                                <option value="">-- Select Subject --</option>
                            </select>
                        </div>
                        <div>
                            <label for="examDropdown">Exam:</label>
                            <select id="examserial" class="form-control" name="ExamSerial" required>
                                <option value="">-- Select Exam --</option>
                            </select>
                        </div>
                        
                        <div class="button-group-inline">
                            <button type="button" class="btn-search" onclick="searchStudents()">Search</button>
                            <button type="button" class="btn-cancel" onclick="location.reload();">Cancel</button>
                        </div>
                    </div>

                    <div id="studentsGrid"></div>

                    <div class="form-group text-center mt-4">
                        <button type="submit" class="btn-download">Download</button>
                    </div>
                }
            </div>
        </div>
    </div>
     


     @if (TempData["Message"] != null)
     {
    <script>
        window.onload = function () {
            var toastLive = document.getElementById('liveToast');
            var toast = new bootstrap.Toast(toastLive);
            toast.show();
        };
    </script>
     }
  @section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function () {

            // log and bind year change
            $('#year').change(function () {
                console.log("Year changed to:", $(this).val());
                loadbatches();
            });

            $('#batchserial').change(function () {
                loadClasses();
                loadSubjects();
            });


            $('#termserial').change(function () {
                loadExam();
            });

            
            $('#subjectserial').change(function () {
                loadExam();
            });


            //load batches
            function loadbatches() {
                var year = $('#year').val();

                if (year) {
                    $.ajax({
                        url: '/Analyze/GetBatchesByYearBothStatus',
                        type: 'GET',
                        data: { year: year },
                        success: function (data) {
                            console.log("Batches received:", data); // debug
                            var batchDropdown = $('#batchserial');
                            batchDropdown.empty();
                            batchDropdown.append('<option value="">-- Select Batch --</option>');
                            $.each(data, function (i, batch) {
                                batchDropdown.append('<option value="' + batch.Value + '">' + batch.Text + '</option>');
                            });
                        },
                        error: function (xhr, status, error) {
                            console.error("Error loading batches:", error);
                            alert('Failed to load batches.');
                        }
                    });
                }
            }


            //load classes
            function loadClasses() {
                var batchSerial = $('#batchserial').val();

                if (batchSerial) {
                    $.ajax({
                        url: '/Analyze/GetClassesByBatchBothStatus',
                        type: 'GET',
                        data: { batchSerial: batchSerial },
                        success: function (data) {
                            var classDropdown = $('#classserial');
                            classDropdown.empty().append('<option value="">-- Select Class --</option>');
                            $.each(data, function (i, item) {
                                classDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                            });
                        }
                    });
                }
            }

            //load subjects
            function loadSubjects() {
                var batchSerial = $('#batchserial').val();

                if (batchSerial) {
                    $.ajax({
                        url: '/Analyze/GetSubjectsByBatch',
                        type: 'GET',
                        data: { batchSerial: batchSerial },
                        success: function (data) {
                            var subjectDropdown = $('#subjectserial');
                            subjectDropdown.empty().append('<option value="">-- Select Subject --</option>');
                            $.each(data, function (i, item) {
                                subjectDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                            });
                        }
                    });
                }
            }


            //load exam
            function loadExam() {
                var termserial = $('#termserial').val();

                if (termserial) {
                    $.ajax({
                        url: '/Analyze/GetExamsAllActive',
                        type: 'GET',
                        data: { termserial: termserial },
                        success: function (data) {
                            var examDropdown = $('#examserial');
                            examDropdown.empty().append('<option value="">-- Select Exam --</option>');
                            $.each(data, function (i, item) {
                                examDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                            });
                        }
                    });
                }
            }
        });
    </script>
}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.20/dist/sweetalert2.all.min.js"></script>

    <script>
        function searchStudents() {
            var year = $('#year').val();
            var batchserial = $('#batchserial').val();
            var classserial = $('#classserial').val();
            var termserial = $('#termserial').val();
            var subjectserial = $('#subjectserial').val();
            var examserial = $('#examserial').val();

            if (!year || !batchserial || !classserial || !termserial || !subjectserial || !examserial) {
                alert("Please select all fields.");
                return;
            }

            $.ajax({
                url: '/Analyze/SearchSubjectRangeReportForGrid',
                type: 'GET',
                data: {
                    year: year,
                    batchserial: batchserial,
                    classserial: classserial,
                    termserial: termserial,
                    subjectserial: subjectserial,
                    examserial: examserial
                },
                success: function (data) {
                    var html = '';
                    if (data.length > 0) {
                        html += '<div class="chart-container" style="position: relative; height:400px; width:100%; display: flex; justify-content: center; align-items: center; margin-top: 20px;">';
                        html += '<canvas id="subjectRangeChart"></canvas>';
                        html += '</div>';
                    } else {
                        html = '<div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> No data found.</div>';
                    }

                    $('#studentsGrid').html(html);

                    if (data.length > 0) {
                        var labels = [];
                        var counts = [];
                        var backgroundColors = ['#4285f4', '#f4b400', '#0f9d58', '#db4437', '#9c27b0', '#00bcd4', '#ff9800', '#795548', '#607d8b']; 
                        
                        for (var i = 0; i < data.length; i++) {
                            labels.push(data[i].MarkRange);
                            counts.push(data[i].StudentCount);
                        }

                        var ctx = document.getElementById('subjectRangeChart').getContext('2d');
                        
                        if (window.subjectRangeChartInstance) {
                            window.subjectRangeChartInstance.destroy();
                        }

                        window.subjectRangeChartInstance = new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: 'No of Students',
                                    data: counts,
                                    backgroundColor: backgroundColors.slice(0, data.length),
                                    borderWidth: 1
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: {
                                        display: true,
                                        position: 'right',
                                        labels: {
                                            font: { size: 14 },
                                            generateLabels: function(chart) {
                                                const data = chart.data;
                                                if (data.labels.length && data.datasets.length) {
                                                    return data.labels.map(function(label, i) {
                                                        const meta = chart.getDatasetMeta(0);
                                                        const style = meta.controller.getStyle(i);
                                                        return {
                                                            text: label,
                                                            fillStyle: style.backgroundColor,
                                                            strokeStyle: style.borderColor,
                                                            lineWidth: style.borderWidth,
                                                            hidden: isNaN(data.datasets[0].data[i]) || meta.data[i].hidden,
                                                            index: i
                                                        };
                                                    });
                                                }
                                                return [];
                                            }
                                        }
                                    },
                                    title: {
                                        display: true,
                                        text: 'Marks - Range',
                                        font: {
                                            size: 24,
                                            weight: 'bold'
                                        },
                                        color: '#000',
                                        padding: {
                                            bottom: 30
                                        }
                                    }
                                },
                                scales: {
                                    x: {
                                        title: {
                                            display: true,
                                            text: 'Marks',
                                            font: { weight: 'bold', size: 14 }
                                        }
                                    },
                                    y: {
                                        title: {
                                            display: true,
                                            text: 'No of Students',
                                            font: { weight: 'bold', size: 14 }
                                        },
                                        beginAtZero: true,
                                        ticks: {
                                            stepSize: 1,
                                            precision: 0
                                        }
                                    }
                                }
                            }
                        });
                    }
                },
                error: function () {
                    alert("Error occurred.");
                }
            });
        }
    </script>
     
    
     <script>
         setTimeout(function () {
             const alert = document.querySelector('.alert');
             if (alert) {
                 alert.style.display = 'none';
             }
         }, 3000); // Hide after 3 seconds
</script>
    
    </body>

    </html>

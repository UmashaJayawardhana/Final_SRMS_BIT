@using Microsoft.AspNet.Identity
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - SRMS</title>
    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <script src="@Url.Content("~/Scripts/jquery-1.7.1.min.js")" type="text/javascript"></script>
    
    <!-- Ionicons -->
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

    <style>
        :root {
            --primary-color: #3b82f6;
            --primary-hover: #2563eb;
            --bg-sidebar: #0f172a;
            --bg-sidebar-hover: rgba(255, 255, 255, 0.07);
            --bg-sidebar-active: #3b82f6;
            --text-sidebar: #94a3b8;
            --text-sidebar-light: #f8fafc;
            --bg-body: #f8fafc;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --card-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02);
            --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Outfit', sans-serif !important;
            background-color: var(--bg-body);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
            padding: 0;
        }

        .sidebar {
            width: 260px;
            background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
            padding: 1.5rem 1.2rem;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            overflow-y: auto;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            z-index: 1000;
            box-shadow: 4px 0 25px rgba(0, 0, 0, 0.15);
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,0.1) transparent;
        }

        .sidebar::-webkit-scrollbar {
            width: 4px;
        }
        .sidebar::-webkit-scrollbar-thumb {
            background-color: rgba(255,255,255,0.1);
            border-radius: 4px;
        }

        .sidebar .brand-title {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 1.5px;
            background: linear-gradient(to right, #3b82f6, #60a5fa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .sidebar .user-profile-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 20px;
            position: relative;
            text-align: center;
        }

        .sidebar .user-img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 3px solid rgba(59, 130, 246, 0.3);
            object-fit: cover;
            display: block;
            margin: 0 auto 10px auto;
            transition: var(--transition-smooth);
        }

        .sidebar .user-img:hover {
            transform: scale(1.05);
            border-color: var(--primary-color);
        }

        .sidebar .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: var(--text-sidebar);
            border-radius: 10px;
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            transition: var(--transition-smooth);
            margin: 4px 0;
            text-align: left;
        }

        .sidebar .nav-link ion-icon {
            font-size: 18px;
            transition: var(--transition-smooth);
        }

        .sidebar .nav-link:hover {
            background-color: var(--bg-sidebar-hover);
            color: var(--text-sidebar-light);
        }

        .sidebar .nav-link:hover ion-icon {
            transform: translateX(3px);
            color: var(--primary-color);
        }

        .sidebar .dropdown-toggle::after {
            margin-left: auto;
            transition: transform 0.3s;
        }

        .sidebar .dropdown-menu {
            background-color: rgba(15, 23, 42, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(10px);
            border-radius: 10px;
            padding: 6px;
            margin-top: 5px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            width: 100%;
        }

        .sidebar .dropdown-item {
            color: var(--text-sidebar);
            padding: 8px 16px;
            font-size: 14px;
            font-weight: 400;
            border-radius: 8px;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sidebar .dropdown-item:hover {
            background-color: var(--bg-sidebar-hover);
            color: #ffffff;
            padding-left: 20px;
        }

        .content-wrapper {
            margin-left: 260px;
            width: calc(100% - 260px);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: var(--transition-smooth);
        }

        .header {
            height: 75px;
            background-color: #ffffff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2rem;
            border-bottom: 1px solid var(--border-color);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.01), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
        }

        .main-content {
            padding: 2.2rem;
            background-color: var(--bg-body);
            flex-grow: 1;
        }

        .header h1 {
            font-size: 22px;
            font-weight: 800;
            margin: 0;
            color: #0f172a;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .header .school-info p {
            margin: 0;
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .header .user-badge {
            font-size: 12px;
            font-weight: 600;
            padding: 6px 12px;
            border-radius: 30px;
            background-color: rgba(59, 130, 246, 0.1);
            color: var(--primary-color);
            border: 1px solid rgba(59, 130, 246, 0.15);
        }

        .header .dropdown-toggle {
            color: var(--text-main);
            font-weight: 600;
            font-size: 14px;
            transition: var(--transition-smooth);
        }

        .header .dropdown-toggle:hover {
            color: var(--primary-color);
        }

        .header .dropdown-menu {
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            padding: 8px;
        }

        .header .dropdown-item {
            border-radius: 8px;
            font-size: 14px;
            padding: 8px 16px;
            transition: var(--transition-smooth);
        }

        .header .dropdown-item:hover {
            background-color: #f1f5f9;
            color: var(--primary-hover);
        }

        /* Modernized General Classes */
        .toast {
            border-radius: 12px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        }

        /* Support for default ASP.NET MVC templates */
        fieldset {
            max-width: 800px;
            width: 100%;
            margin: 20px auto 35px auto;
            padding: 2.2rem;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            background-color: #ffffff;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
        }

        legend {
            font-size: 18px;
            font-weight: 700;
            color: #0f172a;
            width: 100%;
            padding-bottom: 8px;
            border-bottom: 2px solid #e2e8f0;
            margin-bottom: 1.5rem;
            float: none; /* Reset bootstrap absolute float */
        }

        .editor-label {
            margin-top: 1rem;
            margin-bottom: 0.25rem;
        }

        .editor-label label {
            font-size: 14px;
            font-weight: 600;
            color: #475569;
        }

        .editor-field {
            margin-bottom: 1.25rem;
        }

        .editor-field input[type="text"],
        .editor-field input[type="password"],
        .editor-field input[type="email"] {
            width: 100%;
            height: 46px;
            padding: 10px 16px;
            font-size: 14.5px;
            color: #1e293b;
            background-color: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            outline: none;
            transition: all 0.2s ease-in-out;
            box-sizing: border-box;
        }

        .editor-field input[type="text"]:focus,
        .editor-field input[type="password"]:focus,
        .editor-field input[type="email"]:focus {
            background-color: #ffffff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
        }

        .editor-field .field-validation-error {
            display: block;
            color: #ef4444;
            font-size: 12px;
            margin-top: 5px;
        }

        /* Submit input styling matching main buttons */
        input[type="submit"] {
            height: 44px;
            padding: 0 24px;
            font-size: 14px;
            font-weight: 600;
            color: #ffffff;
            background-color: #3b82f6;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.2);
            min-width: 110px;
        }

        input[type="submit"]:hover {
            background-color: #2563eb;
            transform: translateY(-1px);
            box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3);
        }
    </style>
</head>
<body>
    @{
        var userName = Session["FullName"] != null ? Session["FullName"].ToString() : "Guest";
        var userGroup = Session["UserGroupName"] != null ? Session["UserGroupName"].ToString() : "Unknown Role";
        var usergroupserial = Session["UserGroupSerial"] != null ? Session["UserGroupSerial"].ToString() : "";
    }

     
    <div class="sidebar">
        <a href="/Home/DashBoard" class="text-decoration-none">
            <div class="brand-title">
                <ion-icon name="school-outline"></ion-icon>
                <span>SRMS</span>
            </div>
        </a>

        <div class="user-profile-card">
            <img src="@Url.Action("GetUserPhoto", "Account")" alt="User Photo" class="user-img"/>
            <div class="fw-bold text-white mb-1" style="font-size: 14px;">@userName</div>
            <div class="text-muted" style="font-size: 11px;">@userGroup</div>
        </div>

        @Html.Action("RenderMenu", "Layout")
    </div>

    <div class="content-wrapper">
        <div class="header">
            <!-- Left: Logo & School Details -->
            <div class="d-flex align-items-center gap-3">
                <img src="../../Content/img/schlogo.jpeg" height="42" alt="School Logo" style="border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="school-info">
                    <h1 class="m-0 text-primary">MATARA CENTRAL COLLEGE</h1>
                    <p class="text-muted m-0">Empowering Education with Excellence</p>
                </div>
            </div>

            <!-- Right: User Information / Profile & Logout -->
            <div class="d-flex align-items-center gap-3">
                <span class="user-badge">@userGroup</span>

                <!-- Notifications Dropdown -->
                <div class="dropdown">
                    <a class="text-decoration-none text-dark position-relative" href="#" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 20px; margin-right: 15px; margin-top: 5px; display: inline-block;">
                        <ion-icon name="notifications-outline"></ion-icon>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notificationCount" style="font-size: 10px; display: none;">
                            0
                        </span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="notificationDropdown" id="notificationList" style="width: 320px; max-height: 400px; overflow-y: auto;">
                        <li><div class="dropdown-header text-center fw-bold border-bottom pb-2">Notifications</div></li>
                        <li id="noNotifications"><div class="dropdown-item text-center text-muted py-3">No new notifications</div></li>
                    </ul>
                </div>

                <div class="dropdown">
                    <a class="dropdown-toggle text-decoration-none fw-semibold text-dark d-flex align-items-center gap-1" href="#" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        @userName
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="/Account/ProfileChange"><ion-icon name="person-outline" class="me-2"></ion-icon>Profile</a></li>
                        <li><a class="dropdown-item" href="/Account/LogOn"><ion-icon name="log-out-outline" class="me-2"></ion-icon>Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <main class="main-content">
            @RenderBody()
        </main>
        @RenderSection("Scripts", required: false)
    </div>

    <div class="position-fixed top-0 end-0 p-3" style="z-index: 9999">
        <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["Message"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            // Fetch notifications dynamically on page load
            $.ajax({
                url: '/Layout/GetNotifications',
                type: 'GET',
                success: function(data) {
                    if (data && data.length > 0) {
                        $('#notificationCount').text(data.length).show();
                        $('#noNotifications').hide();
                        
                        $.each(data, function(index, item) {
                            var icon = item.Icon ? item.Icon : 'notifications-outline';
                            var li = $('<li></li>');
                            var a = $('<a></a>')
                                .addClass('dropdown-item d-flex align-items-center py-2 border-bottom')
                                .attr('href', item.Url)
                                .css('white-space', 'normal');
                            
                            var iconSpan = $('<span></span>').addClass('me-3 text-primary').css('font-size', '20px').html('<ion-icon name="' + icon + '"></ion-icon>');
                            var textSpan = $('<span></span>').addClass('text-dark').css('font-size', '13px').text(item.Message);
                            
                            a.append(iconSpan).append(textSpan);
                            li.append(a);
                            $('#notificationList').append(li);
                        });
                    } else {
                        $('#notificationCount').hide();
                        $('#noNotifications').show();
                    }
                },
                error: function() {
                    console.error("Failed to load notifications.");
                }
            });
        });
    </script>
</body>
</html>


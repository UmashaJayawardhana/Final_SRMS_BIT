@{
    ViewBag.Title = "FinalExamSchedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- FinalExamSchedule.cshtml content -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/StyleSheet4.css")" />

    <title>FinalExamSchedule</title>

    <style>
        /* Scoped styling for FinalExamSchedule enhancements */

        /* Metric / Stat Cards */
        .stat-card {
            border-radius: 12px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            background: #ffffff;
            border: 1px solid #e2e8f0;
        }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02) !important;
        }
        .bg-primary-subtle {
            background-color: rgba(59, 130, 246, 0.08) !important;
        }
        .bg-warning-subtle {
            background-color: rgba(245, 158, 11, 0.08) !important;
        }
        .bg-success-subtle {
            background-color: rgba(34, 197, 94, 0.08) !important;
        }
        .bg-danger-subtle {
            background-color: rgba(239, 68, 68, 0.08) !important;
        }

        /* Strict 2-Column Form Grid Layout */
        .form-grid-container {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            column-gap: 24px !important;
            row-gap: 0 !important;
        }
        @@media (max-width: 768px) {
            .form-grid-container {
                grid-template-columns: 1fr !important;
            }
        }
        .form-grid-container .form-group {
            display: flex !important;
            flex-direction: column !important;
            gap: 6px !important;
            margin-bottom: 1.25rem !important;
        }
        .form-grid-container label {
            font-weight: 600;
            color: #475569;
            margin-bottom: 2px;
            width: auto !important;
        }
        .form-grid-container .form-control {
            height: 44px !important;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            padding: 8px 12px;
            font-size: 14px;
            width: 100% !important;
        }
        .form-grid-container .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
            outline: none;
        }

        /* Buttons container - single row */
        .actions-row {
            display: flex !important;
            flex-direction: row !important;
            gap: 12px;
            justify-content: center;
            align-items: center;
            margin-top: 24px;
            flex-wrap: wrap;
        }
        .btn-custom {
            height: 44px;
            padding: 0 24px;
            font-weight: 600;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            min-width: 120px;
            transition: all 0.2s ease;
        }
        .btn-custom:hover {
            transform: translateY(-1px);
            opacity: 0.95;
        }

        /* Edit Mode dynamic classes */
        .addform.editing-state {
            border: 2px solid #8b5cf6 !important;
            box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.15), 0 8px 10px -6px rgba(139, 92, 246, 0.08) !important;
        }
        .editing-row {
            background-color: rgba(139, 92, 246, 0.06) !important;
            border-left: 4px solid #8b5cf6 !important;
        }
        .editing-row td {
            font-weight: 500;
            color: #6d28d9 !important;
        }

        /* Table custom styling */
        .addtable-container {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
        .addtable {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            background-color: #ffffff;
        }
        .addtable th, .addtable td {
            border: 1px solid #e2e8f0 !important;
            padding: 12px;
            text-align: center;
        }
        .addtable th {
            background-color: #f8fafc;
            font-weight: 600;
            color: #334155;
        }
        .addtable tbody tr {
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .addtable tbody tr:hover {
            background-color: #f1f5f9;
        }
        .addtable tbody tr.table-active-row {
            background-color: rgba(59, 130, 246, 0.08) !important;
            border-left: 4px solid #3b82f6 !important;
        }

        /* Status Badge Styling */
        .status-badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
        }
        .status-pending { background-color: #fef3c7; color: #d97706; }
        .status-held { background-color: #dcfce7; color: #15803d; }
        .status-cancelled { background-color: #fee2e2; color: #b91c1c; }

        /* Filter Search */
        .filter-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
            outline: none;
        }
    </style>
</head>
<body>
    @model List<MvcApplication1.Models.ExamScheduleModels>
    @{
        var terms = ViewBag.Terms as List<MvcApplication1.Models.TermModels> ?? new List<MvcApplication1.Models.TermModels>();
    }

    <!-- Metrics / Statistics Panel -->
    <div class="row g-3 mb-4" style="max-width: 950px; margin: 0 auto 1.5rem auto;">
        <div class="col-md-3 col-6">
            <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="font-size: 22px; width: 48px; height: 48px;">
                    &#x1F4C5;
                </div>
                <div>
                    <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Total Schedules</h6>
                    <h4 class="mb-0 fw-bold" id="statTotalSchedules" style="margin: 0;">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon bg-warning-subtle text-warning rounded-3 p-2 d-flex align-items-center justify-content-center" style="font-size: 22px; width: 48px; height: 48px;">
                    &#x23F3;
                </div>
                <div>
                    <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Pending</h6>
                    <h4 class="mb-0 fw-bold" id="statPendingSchedules" style="margin: 0;">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success rounded-3 p-2 d-flex align-items-center justify-content-center" style="font-size: 22px; width: 48px; height: 48px;">
                    &#x2705;
                </div>
                <div>
                    <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Held</h6>
                    <h4 class="mb-0 fw-bold" id="statHeldSchedules" style="margin: 0;">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon bg-danger-subtle text-danger rounded-3 p-2 d-flex align-items-center justify-content-center" style="font-size: 22px; width: 48px; height: 48px;">
                    &#x274C;
                </div>
                <div>
                    <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Cancelled</h6>
                    <h4 class="mb-0 fw-bold" id="statCancelledSchedules" style="margin: 0;">0</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Container -->
    <div class="container" style="max-width: 950px; margin: 0 auto;">
        @using (Html.BeginForm("FinalExamSchedule", "Exam", FormMethod.Post, new { enctype = "multipart/form-data", @class = "addform", id = "FinalExamScheduleForm", onsubmit = "return validateDates();" }))
        {
            <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
                <h4 id="formHeader" class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; width: 100%; border-bottom: none;">
                    <span id="formHeaderEmoji">&#x2795;</span> <span id="formHeaderText">Final Exam Schedule</span>
                </h4>
                <span id="formBadge" class="badge bg-purple text-white px-2 py-1" style="display: none; background-color: #8b5cf6; font-size: 11px; font-weight: 600; border-radius: 6px;">EDIT MODE</span>
            </div>

            <input type="hidden" id="examscheduleSerial" name="ExamScheduleSerial" />

            <!-- 2-Column Form Layout -->
            <div class="form-grid-container">
                <div class="form-group">
                    <label for="year">Year:</label>
                    @Html.DropDownList("Year", (SelectList)ViewBag.Years, "--Select Year--", new { @class = "form-control", @id = "year", required = "required" })
                </div>
                <div class="form-group">
                    <label for="batchserial">Batch:</label>
                    <select id="batchserial" class="form-control" name="BatchSerial" required>
                        <option value="">-- Select Batch --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="termserial">Term:</label>
                    <select id="termserial" class="form-control" name="TermSerial" required>
                        <option value="">-- Select Term --</option>
                        @foreach (var term in terms)
                        {
                            <option value="@term.TermSerial">@term.TermName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="examserial">Exam:</label>
                    <select id="examserial" class="form-control" name="ExamSerial" required>
                        <option value="">-- Select Exam --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="subjectserial">Subject:</label>
                    <select id="subjectserial" class="form-control" name="SubjectSerial" required>
                        <option value="">-- Select Subject --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="status">Status:</label>
                    <select id="status" class="form-control" name="Status" required>
                        <option value="Pending">Pending</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="examdatetime">Date & Time:</label>
                    <input type="datetime-local" id="examdatetime" class="form-control" name="DateTime" required />
                </div>
            </div>

            <!-- Single Row Action Buttons -->
            <div class="actions-row">
                <button type="submit" id="saveBtn" class="btn-custom" style="background-color: #3b82f6; color: white;">Save Schedule</button>
                <button type="button" id="toggleListBtn" class="btn-custom" style="background-color: #0f172a; color: white;" onclick="toggleList();">Show Table</button>
                <button type="button" id="cancelBtn" class="btn-custom" style="background-color: #ef4444; color: white;" onclick="resetForm();">Cancel</button>
            </div>
        }

        <!-- Table Container -->
        <div id="listContainer" class="mt-4 d-none">
            <div class="addtable-container border-0 shadow-sm p-4 bg-white rounded-4" style="margin: 1.5rem auto 3rem auto;">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
                    <h4 class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; border-bottom: none; width: auto;">
                        <span style="font-size: 22px; margin-right: 2px;">&#x1F393;</span> Final Exam Schedule Table
                    </h4>
                    <!-- Search Control -->
                    <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end" style="margin-left: auto;">
                        <div class="position-relative flex-grow-1" style="max-width: 320px;">
                            <input type="text" id="tableSearch" class="form-control filter-control" placeholder="&#x1F50D; Search Final Schedules..." style="height: 40px; font-size: 14px; border-radius: 8px;" />
                        </div>
                    </div>
                </div>

                <!-- Table -->
                <div class="table-responsive">
                    <table class="table addtable align-middle" id="finalScheduleTable">
                        <thead>
                            <tr>
                                <th style="display:none;">Serial No</th> 
                                <th>No</th>
                                <th>Year</th>
                                <th style="display:none;">BatchSerial</th>
                                <th>Batch Name</th>
                                <th style="display:none;">TermSerial</th>
                                <th>Term Name</th>
                                <th style="display:none;">SubjectSerial</th>
                                <th>Subject Name</th>
                                <th style="display:none;">ExamSerial</th>
                                <th>Exam Name</th>
                                <th>Status</th>
                                <th>Date & Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exam in Model)
                            {
                                <tr onclick="fillForm(this)">
                                    <td style="display:none;" class="col-serial">@exam.ExamScheduleSerial</td>
                                    <td class="col-no">@exam.No</td>
                                    <td class="col-year">@exam.Year</td>
                                    <td style="display:none;" class="col-batchserial">@exam.BatchSerial</td>
                                    <td class="col-batchname">@exam.BatchName</td>
                                    <td style="display:none;" class="col-termserial">@exam.TermSerial</td>
                                    <td class="col-termname">@exam.TermName</td>
                                    <td style="display:none;" class="col-subjectserial">@exam.SubjectSerial</td>
                                    <td class="col-subjectname">@exam.SubjectName</td>
                                    <td style="display:none;" class="col-examserial">@exam.ExamSerial</td>
                                    <td class="col-examname">@exam.ExamName</td>
                                    <td class="col-status">
                                        @if (exam.Status == "Pending")
                                        {
                                            <span class="status-badge status-pending">Pending</span>
                                        }
                                        else if (exam.Status == "Held")
                                        {
                                            <span class="status-badge status-held">Held</span>
                                        }
                                        else if (exam.Status == "Cancelled")
                                        {
                                            <span class="status-badge status-cancelled">Cancelled</span>
                                        }
                                        else
                                        {
                                            @exam.Status
                                        }
                                    </td>
                                    <td class="col-datetime">@exam.DateTime</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Empty Search State -->
                <div id="emptyState" class="text-center py-5 d-none">
                    <div style="font-size: 40px; opacity: 0.5;">&#x1F50D;</div>
                    <h5 class="text-muted fw-normal" style="font-size: 16px;">No matching final exam schedules found</h5>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <script>
            window.onload = function () {
                var toastLive = document.getElementById('liveToast');
                if (toastLive) {
                    var toast = new bootstrap.Toast(toastLive);
                    toast.show();
                }
            };
        </script>
    }

    @section Scripts {
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script>
            function calculateStats() {
                var rows = $("#finalScheduleTable tbody tr");
                var total = rows.length;
                var pending = 0, held = 0, cancelled = 0;

                rows.each(function () {
                    var statusText = $(this).find(".col-status").text().trim();
                    if (statusText.indexOf("Pending") > -1) pending++;
                    else if (statusText.indexOf("Held") > -1) held++;
                    else if (statusText.indexOf("Cancelled") > -1) cancelled++;
                });

                $("#statTotalSchedules").text(total);
                $("#statPendingSchedules").text(pending);
                $("#statHeldSchedules").text(held);
                $("#statCancelledSchedules").text(cancelled);
            }

            $(document).ready(function () {
                calculateStats();

                // Live search filter
                $("#tableSearch").on("keyup input", filterTable);

                // Dropdown cascade bindings
                $('#year').change(function () {
                    loadbatches();
                });

                $('#batchserial').change(function () {
                    loadSubjects();
                });

                $('#termserial').change(function () {
                    loadExam();
                });

                function loadbatches() {
                    var year = $('#year').val();
                    if (year) {
                        $.ajax({
                            url: '/Exam/GetBatchesByYearBothStatusByBatchHead',
                            type: 'GET',
                            data: { year: year },
                            success: function (data) {
                                var batchDropdown = $('#batchserial');
                                batchDropdown.empty().append('<option value="">-- Select Batch --</option>');
                                $.each(data, function (i, batch) {
                                    batchDropdown.append('<option value="' + batch.Value + '">' + batch.Text + '</option>');
                                });
                            },
                            error: function (xhr, status, error) {
                                console.error("Error loading batches:", error);
                            }
                        });
                    }
                }

                function loadSubjects() {
                    var batchSerial = $('#batchserial').val();
                    if (batchSerial) {
                        $.ajax({
                            url: '/Exam/GetSubjectsByBatch',
                            type: 'GET',
                            data: { batchSerial: batchSerial },
                            success: function (data) {
                                var subjectDropdown = $('#subjectserial');
                                subjectDropdown.empty().append('<option value="">-- Select Subject --</option>');
                                $.each(data, function (i, item) {
                                    subjectDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                                });
                            }
                        });
                    }
                }

                function loadExam() {
                    var termserial = $('#termserial').val();
                    if (termserial) {
                        $.ajax({
                            url: '/Exam/GetExamsByTermForFinal',
                            type: 'GET',
                            data: { termserial: termserial },
                            success: function (data) {
                                var examDropdown = $('#examserial');
                                examDropdown.empty().append('<option value="">-- Select Exam --</option>');
                                $.each(data, function (i, item) {
                                    examDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                                });
                            }
                        });
                    }
                }
            });

            function filterTable() {
                var searchQuery = $("#tableSearch").val().toLowerCase();
                var visibleRows = 0;

                $("#finalScheduleTable tbody tr").each(function () {
                    var row = $(this);
                    var text = row.text().toLowerCase();

                    if (text.indexOf(searchQuery) > -1) {
                        row.removeClass("d-none");
                        visibleRows++;
                    } else {
                        row.addClass("d-none");
                    }
                });

                if (visibleRows === 0) {
                    $("#emptyState").removeClass("d-none");
                    $("#finalScheduleTable").addClass("d-none");
                } else {
                    $("#emptyState").addClass("d-none");
                    $("#finalScheduleTable").removeClass("d-none");
                }
            }

            function toggleList() {
                var container = document.getElementById("listContainer");
                var btn = document.getElementById("toggleListBtn");
                if (container.classList.contains("d-none")) {
                    container.classList.remove("d-none");
                    btn.innerText = "Hide Table";
                    btn.style.backgroundColor = "#475569";
                    container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } else {
                    container.classList.add("d-none");
                    btn.innerText = "Show Table";
                    btn.style.backgroundColor = "#0f172a";
                }
            }

            function fillForm(row) {
                $("#finalScheduleTable tbody tr").removeClass("editing-row table-active-row");
                $(row).addClass("editing-row table-active-row");

                var cells = row.getElementsByTagName("td");

                document.getElementById("examscheduleSerial").value = cells[0].innerText.trim();
                document.getElementById("year").value = cells[2].innerText.trim();

                const year = cells[2].innerText.trim();
                const batchserial = cells[3].innerText.trim();
                const termserial = cells[5].innerText.trim();
                const subjectserial = cells[7].innerText.trim();
                const examserial = cells[9].innerText.trim();
                const status = cells[11].innerText.trim();
                const rawDateTime = cells[12].innerText.trim();

                // Dynamically load status options for edit mode
                var $statusDropdown = $('#status');
                $statusDropdown.empty();
                $statusDropdown.append('<option value="Pending">Pending</option>');
                $statusDropdown.append('<option value="Cancelled">Cancelled</option>');
                $statusDropdown.append('<option value="Held">Held</option>');
                $statusDropdown.val(status);

                document.getElementById("termserial").value = termserial;

                var parsedDate = new Date(rawDateTime);
                if (!isNaN(parsedDate.getTime())) {
                    var yyyy = parsedDate.getFullYear();
                    var mm = String(parsedDate.getMonth() + 1).padStart(2, '0');
                    var dd = String(parsedDate.getDate()).padStart(2, '0');
                    var hh = String(parsedDate.getHours()).padStart(2, '0');
                    var min = String(parsedDate.getMinutes()).padStart(2, '0');

                    var formatted = `${yyyy}-${mm}-${dd}T${hh}:${min}`;
                    document.getElementById("examdatetime").value = formatted;
                }

                // Edit Mode UI adjustments
                $("#FinalExamScheduleForm").addClass("editing-state");
                document.getElementById("formHeaderEmoji").innerHTML = "&#x270F;";
                document.getElementById("formHeaderText").innerHTML = "Edit Final Exam Schedule (ID: " + cells[0].innerText.trim() + ")";
                $("#formBadge").fadeIn(200);
                $("#saveBtn").text("Update Schedule").css("background-color", "#8b5cf6");

                // Load cascading dropdown values
                $.get('/Exam/GetBatchesByYearBothStatusByBatchHead', { year: year }, function (batches) {
                    var $batchDropdown = $('#batchserial');
                    $batchDropdown.empty().append('<option value="">-- Select Batch --</option>');
                    $.each(batches, function (i, batch) {
                        $batchDropdown.append(`<option value="${batch.Value}">${batch.Text}</option>`);
                    });
                    $batchDropdown.val(batchserial);

                    $.get('/Exam/GetSubjectsByBatch', { batchSerial: batchserial }, function (subjects) {
                        var $subjectDropdown = $('#subjectserial');
                        $subjectDropdown.empty().append('<option value="">-- Select Subject --</option>');
                        $.each(subjects, function (i, sub) {
                            $subjectDropdown.append(`<option value="${sub.Value}">${sub.Text}</option>`);
                        });
                        $subjectDropdown.val(subjectserial);

                        $.get('/Exam/GetExamsByTermForFinal', { termserial: termserial }, function (exams) {
                            var $examDropdown = $('#examserial');
                            $examDropdown.empty().append('<option value="">-- Select Exam --</option>');
                            $.each(exams, function (i, exm) {
                                $examDropdown.append(`<option value="${exm.Value}">${exm.Text}</option>`);
                            });
                            $examDropdown.val(examserial);
                        });
                    });
                });

                document.getElementById("FinalExamScheduleForm").scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            function resetForm() {
                document.getElementById("examscheduleSerial").value = "";
                document.getElementById("FinalExamScheduleForm").reset();

                // Restrict status dropdown back to only "Pending"
                var $statusDropdown = $('#status');
                $statusDropdown.empty();
                $statusDropdown.append('<option value="Pending">Pending</option>');
                $statusDropdown.val('Pending');

                $("#finalScheduleTable tbody tr").removeClass("editing-row table-active-row");
                $("#FinalExamScheduleForm").removeClass("editing-state");
                document.getElementById("formHeaderEmoji").innerHTML = "&#x2795;";
                document.getElementById("formHeaderText").innerHTML = "Final Exam Schedule";
                $("#formBadge").fadeOut(200);

                $("#saveBtn").text("Save Schedule").css("background-color", "#3b82f6");
            }

            function validateDates() {
                var now = new Date();
                var examDateTime = document.getElementById("examdatetime").value;
                var status = document.getElementById("status").value;

                if (examDateTime) {
                    var selectedDate = new Date(examDateTime);

                    // Weekend validation
                    var dayOfWeek = selectedDate.getDay();
                    if (dayOfWeek === 0 || dayOfWeek === 6) {
                        alert("Final exams cannot be scheduled on weekends (Saturday and Sunday).");
                        return false;
                    }

                    // School hours validation (8:00 AM to 12:00 PM)
                    var hours = selectedDate.getHours();
                    var minutes = selectedDate.getMinutes();
                    var totalMinutes = hours * 60 + minutes;
                    if (totalMinutes < 480 || totalMinutes > 720) { // 8:00 AM = 480, 12:00 PM = 720
                        alert("Final exams can only be scheduled between 8:00 AM and 12:00 PM.");
                        return false;
                    }

                    // Overlap validation for the same batch (within 90 minutes)
                    var batchSerial = document.getElementById("batchserial").value;
                    var editingSerial = document.getElementById("examscheduleSerial").value || "0";

                    var hasConflict = false;
                    $("#finalScheduleTable tbody tr").each(function () {
                        var $row = $(this);
                        var rowSerial = $row.find(".col-serial").text().trim();
                        var rowBatchSerial = $row.find(".col-batchserial").text().trim();
                        var rowDateTimeStr = $row.find(".col-datetime").text().trim();

                        if (rowBatchSerial === batchSerial && rowSerial !== editingSerial) {
                            var rowDate = new Date(rowDateTimeStr);
                            if (!isNaN(rowDate.getTime())) {
                                var diffMs = Math.abs(selectedDate - rowDate);
                                var diffMins = diffMs / 1000 / 60;
                                if (diffMins < 90) {
                                    hasConflict = true;
                                    return false; // break loop
                                }
                            }
                        }
                    });

                    if (hasConflict) {
                        alert("Conflict: Another final exam is already scheduled for this batch within a 90-minute interval.");
                        return false;
                    }

                    if (status === "Pending" && selectedDate < now) {
                        alert("Exam date and time cannot be in the past.");
                        return false;
                    }
                    if (status === "Held" && selectedDate > now) {
                        alert("Exam status cannot be set to 'Held' for future dates.");
                        return false;
                    }
                } else {
                    alert("Please select the exam date and time.");
                    return false;
                }

                return true;
            }

            setTimeout(function () {
                const alert = document.querySelector('.alert');
                if (alert) {
                    alert.style.display = 'none';
                }
            }, 3000);
        </script>
    }
</body>
</html>

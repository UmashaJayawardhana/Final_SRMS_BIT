@{
    ViewBag.Title = "FinalExamTimeTable";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- FinalExamTimeTable.cshtml content -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/StyleSheet4.css")" />


    <title>FinalExamTimeTable</title>

</head>
<body>
    
<style>
.addform .row {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: wrap !important;
}
.addform .row > div {
    display: flex !important;
    flex-direction: column !important;
    margin-bottom: 1.25rem;
}
.inline-form-row {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: wrap !important;
    align-items: flex-end !important;
    gap: 12px !important;
    margin-bottom: 1.5rem;
    width: 100%;
}
.inline-form-row > div {
    flex: 1 1 150px !important;
    display: flex !important;
    flex-direction: column !important;
    margin-bottom: 0 !important;
}
.inline-form-row .button-group-inline {
    flex: 0 0 auto !important;
    display: flex !important;
    flex-direction: row !important;
    gap: 10px !important;
    align-items: center !important;
}
.addtable {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
     background-color: #ffffff;
}

.addtable th, .addtable td {
    border: 1px solid black !important;
    padding: 8px;
    text-align: center;
}

.btn-search {
    background-color: #22c55e !important; /* Green */
    box-shadow: 0 4px 6px -1px rgba(34, 197, 94, 0.2) !important;
}
.btn-search:hover {
    background-color: #16a34a !important;
    box-shadow: 0 10px 15px -3px rgba(34, 197, 94, 0.3) !important;
}

.btn-cancel {
    background-color: #ef4444 !important; /* Red */
    box-shadow: 0 4px 6px -1px rgba(239, 68, 68, 0.2) !important;
}
.btn-cancel:hover {
    background-color: #dc2626 !important;
    box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.3) !important;
}

.btn-download {
    background-color: #64748b !important; /* Slate / Grey */
    box-shadow: 0 4px 6px -1px rgba(100, 116, 139, 0.2) !important;
}
.btn-download:hover {
    background-color: #475569 !important;
    box-shadow: 0 10px 15px -3px rgba(100, 116, 139, 0.3) !important;
}

.btn-upload {
    background-color: #3b82f6 !important; /* Blue */
    box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.2) !important;
}
.btn-upload:hover {
    background-color: #2563eb !important;
    box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3) !important;
}
</style>
      
    @model List<MvcApplication1.Models.ExamScheduleModels>
    @{
        
        var terms = ViewBag.Terms as List<MvcApplication1.Models.TermModels>;
    }
    
    <!-- Form -->
    <div class="container">
<h4>&#x2795;Final Exam TimeTable</h4>
 @using (Html.BeginForm("GenerateFianlExamTimeTablePDF", "Exam", FormMethod.Post, new { enctype = "multipart/form-data", @class = "addform", id = "ApprovedResultClassTeacherForm" }))
 {
      <!-- Form contents here -->      <div class="inline-form-row">
          <div>
              <label for="year">Year:</label>
              @Html.DropDownList("Year",(SelectList)ViewBag.Years, "--Select Year--", new { @class = "form-control", @id = "year",  required = "required" })
          </div>
          <div>
              <label for="batchserial">Batch:</label>
              <select id="batchserial" class="form-control" name="BatchSerial" required>
                  <option value="">-- Select Batch --</option>
              </select>
          </div>
          <div>
              <label for="termserial">Term:</label>
              <select id="termserial" class="form-control" name="TermSerial" required>
                  <option value="">-- Select Term --</option>
                  @foreach (var term in terms)
                  {
                      <option value="@term.TermSerial">@term.TermName</option>
                  }
              </select>
          </div>
          <div>
              <label for="examserial">Exam:</label>
              <select id="examserial" class="form-control" name="ExamSerial" required>
                  <option value="">-- Select Exam --</option>
              </select>
          </div>
          <div class="button-group-inline">
              <button type="button" class="btn-search" onclick="searchStudents()">Search</button>
              <button type="button" class="btn-download" style="width: 170px;" onclick="submitForm('Download')">Download PDF</button>
              <button type="button" class="btn-upload" style="width: 170px;" onclick="submitForm('Upload')">Upload Table</button>
          </div>
      </div>
 
<div id="studentsGrid">
       
    </div>
<hr />
        
 }        
   <!-- Upload PDF form -->
        @using (Html.BeginForm("UploadFianlExamTimeTablePDF", "Exam", FormMethod.Post, new { enctype = "multipart/form-data", @class = "addform", id = "uploadForm" }))
        {
            <div class="inline-form-row">
                <div style="flex: 1 1 300px !important;">
                    <label for="uploadFile">Upload PDF:</label>
                    <input type="file" id="uploadFile" name="uploadFile" class="form-control" accept="application/pdf" required />
                </div>

                <!-- Pass the same selected values as hidden fields -->
                <input type="hidden" id="uploadYear" name="year" />
                <input type="hidden" id="uploadBatchSerial" name="batchserial" />
                <input type="hidden" id="uploadTermSerial" name="termserial" />
                <input type="hidden" id="uploadExamSerial" name="examserial" />

                <div class="button-group-inline">
                    <button type="submit" class="btn-upload" style="width: 170px;" id="uploadBtn" disabled>Upload PDF</button>
                    <button type="button" class="btn-cancel" onclick="location.reload();">Cancel</button>
                </div>
            </div>
        }
    </div>

    

     @if (TempData["Message"] != null)
     {
    <script>
        window.onload = function () {
            var toastLive = document.getElementById('liveToast');
            var toast = new bootstrap.Toast(toastLive);
            toast.show();
        };
    </script>
     }
  @section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {

            // log and bind year change
            $('#year').change(function () {
                console.log("Year changed to:", $(this).val());
                loadbatches();
            });



            $('#termserial').change(function () {
                loadExam();
            });

            //load batches
            function loadbatches() {
                var year = $('#year').val();

                if (year) {
                    $.ajax({
                        url: '/Exam/GetBatchesByYearBothStatus',
                        type: 'GET',
                        data: { year: year },
                        success: function (data) {
                            console.log("Batches received:", data); // debug
                            var batchDropdown = $('#batchserial');
                            batchDropdown.empty();
                            batchDropdown.append('<option value="">-- Select Batch --</option>');
                            $.each(data, function (i, batch) {
                                batchDropdown.append('<option value="' + batch.Value + '">' + batch.Text + '</option>');
                            });
                        },
                        error: function (xhr, status, error) {
                            console.error("Error loading batches:", error);
                            alert('Failed to load batches.');
                        }
                    });
                }
            }


            


            //load exam
            function loadExam() {
                var termserial = $('#termserial').val();

                if (termserial) {
                    $.ajax({
                        url: '/Exam/GetExamsAllFinalPending',
                        type: 'GET',
                        data: { termserial: termserial },
                        success: function (data) {
                            var examDropdown = $('#examserial');
                            examDropdown.empty().append('<option value="">-- Select Exam --</option>');
                            $.each(data, function (i, item) {
                                examDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                            });
                        }
                    });
                }
            }

        });
    </script>
}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
   <script>
       // Enable upload button only when a file is selected
       $('#uploadFile').on('change', function () {
           $('#uploadBtn').prop('disabled', this.files.length === 0);
       });

       // Copy dropdown selections to upload form hidden inputs before submitting upload form
       $('#uploadForm').on('submit', function () {
           $('#uploadYear').val($('#year').val());
           $('#uploadBatchSerial').val($('#batchserial').val());
           $('#uploadTermSerial').val($('#termserial').val());
           $('#uploadExamSerial').val($('#examserial').val());
       });
    </script>
    <script>
        function submitForm(actionName) {
            var year = $('#year').val();
            var batchserial = $('#batchserial').val();
            var termserial = $('#termserial').val();
            var examserial = $('#examserial').val();

            if (!year || !batchserial || !termserial || !examserial) {
                alert("Please select all fields.");
                return;
            }

            var form = $('#ApprovedResultClassTeacherForm');
            if (actionName === 'Download') {
                form.attr('action', '/Exam/GenerateFianlExamTimeTablePDF');
                form.submit();
            } else if (actionName === 'Upload') {
                form.attr('action', '/Exam/UploadFinalExamTimeTableDirectly');
                form.submit();
            }
        }
    </script>
    <script>
        function searchStudents() {
            var year = $('#year').val();
            var batchserial = $('#batchserial').val();
            var termserial = $('#termserial').val();
            var examserial = $('#examserial').val();


            // Client-side validation
            if (!year || !batchserial ||  !termserial ||  !examserial) {
                alert("Please select all fields.");
                return;
            }



            $.ajax({
                url: '/Exam/SearchforFinalExamTimeTable',
                type: 'GET',
                data: {
                    year: year,
                    batchserial: batchserial,
                    termserial: termserial,
                    examserial: examserial
                },
                success: function (data) {
                    var html = '';
                    if (data.length > 0) {
                        html += '<table class="addtable">';
                        html += '<tr><th>No</th><th>Subject Name</th><th>Date & Time</th></tr>';

                        for (var i = 0; i < data.length; i++) {
                            html += '<tr>';
                            html += '<td>' + data[i].No + '</td>';
                            html += '<td>' + data[i].SubjectName + '</td>';
                            let timestamp = parseInt(data[i].DateTime.replace(/[^0-9]/g, ""));
                            let dt = new Date(timestamp);
                            let formattedDateTime = dt.getFullYear() + '-' +
                                String(dt.getMonth() + 1).padStart(2, '0') + '-' +
                                String(dt.getDate()).padStart(2, '0') + ' ' +
                                String(dt.getHours()).padStart(2, '0') + ':' +
                                String(dt.getMinutes()).padStart(2, '0');
                            html += '<td>' + formattedDateTime + '</td>';
                            html += '</tr>';
                        }

                        html += '</table>';

                    } else {
                        html = "<p>No Exams found.</p>";
                    }

                    $('#studentsGrid').html(html);
                },

                error: function () {
                    alert("Error occurred.");
                }
            });
        }

       
</script>
    
     <script>
         setTimeout(function () {
             const alert = document.querySelector('.alert');
             if (alert) {
                 alert.style.display = 'none';
             }
         }, 3000); // Hide after 3 seconds
</script>
    
    </body>

    </html>


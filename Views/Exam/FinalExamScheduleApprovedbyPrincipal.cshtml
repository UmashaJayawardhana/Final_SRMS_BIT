@{
    ViewBag.Title = "FinalExamScheduleApprovedbyPrincipal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- FinalExamScheduleApprovedbyPrincipal.cshtml content -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/StyleSheet4.css")" />

    <title>FinalExamScheduleApprovedbyPrincipal</title>

    <style>
        /* Scoped styling for Principal Approval Page */

        /* Metric / Stat Cards */
        .stat-card {
            border-radius: 12px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            background: #ffffff;
            border: 1px solid #e2e8f0;
        }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02) !important;
        }
        .bg-primary-subtle {
            background-color: rgba(59, 130, 246, 0.08) !important;
        }
        .bg-success-subtle {
            background-color: rgba(34, 197, 94, 0.08) !important;
        }
        .bg-warning-subtle {
            background-color: rgba(245, 158, 11, 0.08) !important;
        }

        /* Strict 2-Column Form Grid Layout */
        .form-grid-container {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            column-gap: 24px !important;
            row-gap: 0 !important;
        }
        @@media (max-width: 768px) {
            .form-grid-container {
                grid-template-columns: 1fr !important;
            }
        }
        .form-grid-container .form-group {
            display: flex !important;
            flex-direction: column !important;
            gap: 6px !important;
            margin-bottom: 1.25rem !important;
        }
        .form-grid-container label {
            font-weight: 600;
            color: #475569;
            margin-bottom: 2px;
            width: auto !important;
        }
        .form-grid-container .form-control {
            height: 44px !important;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            padding: 8px 12px;
            font-size: 14px;
            width: 100% !important;
        }
        .form-grid-container .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
            outline: none;
        }

        /* Buttons container - single row */
        .actions-row {
            display: flex !important;
            flex-direction: row !important;
            gap: 12px;
            justify-content: center;
            align-items: center;
            margin-top: 24px;
            flex-wrap: wrap;
        }
        .btn-custom {
            height: 44px;
            padding: 0 24px;
            font-weight: 600;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            min-width: 130px;
            transition: all 0.2s ease;
        }
        .btn-custom:hover {
            transform: translateY(-1px);
            opacity: 0.95;
        }

        /* Table custom styling */
        .addtable-container {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
        .addtable {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            background-color: #ffffff;
        }
        .addtable th, .addtable td {
            border: 1px solid #e2e8f0 !important;
            padding: 12px;
            text-align: center;
        }
        .addtable th {
            background-color: #f8fafc;
            font-weight: 600;
            color: #334155;
        }
        .addtable tbody tr:hover {
            background-color: #f1f5f9;
        }

        /* Status & Approval Badges */
        .status-badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
        }
        .badge-approved { background-color: #dcfce7; color: #15803d; }
        .badge-pending { background-color: #fef3c7; color: #d97706; }

        .filter-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
            outline: none;
        }

        /* Row Action Approve Button */
        .row-approve-btn {
            background-color: #10b981;
            color: #ffffff;
            border: none;
            padding: 6px 14px;
            font-size: 13px;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 2px 4px rgba(16, 185, 129, 0.1);
        }
        .row-approve-btn:hover {
            background-color: #059669;
            transform: translateY(-1px);
            box-shadow: 0 4px 6px rgba(16, 185, 129, 0.2);
        }
        .row-approve-btn:disabled {
            background-color: #cbd5e1;
            color: #94a3b8;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
    </style>
</head>
<body>
    @model List<MvcApplication1.Models.ExamScheduleModels>
    @{
        var terms = ViewBag.Terms as List<MvcApplication1.Models.TermModels> ?? new List<MvcApplication1.Models.TermModels>();
    }

    <!-- Metrics / Statistics Panel -->
    <div class="row g-3 mb-4" style="max-width: 950px; margin: 0 auto 1.5rem auto;">
        <div class="col-md-4 col-12">
            <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="font-size: 22px; width: 48px; height: 48px;">
                    &#x1F4C5;
                </div>
                <div>
                    <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Exams Listed</h6>
                    <h4 class="mb-0 fw-bold" id="statTotalExams" style="margin: 0;">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-12">
            <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon bg-warning-subtle text-warning rounded-3 p-2 d-flex align-items-center justify-content-center" style="font-size: 22px; width: 48px; height: 48px;">
                    &#x23F3;
                </div>
                <div>
                    <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Pending Approval</h6>
                    <h4 class="mb-0 fw-bold" id="statPendingApproval" style="margin: 0;">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-12">
            <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success rounded-3 p-2 d-flex align-items-center justify-content-center" style="font-size: 22px; width: 48px; height: 48px;">
                    &#x2705;
                </div>
                <div>
                    <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Approved</h6>
                    <h4 class="mb-0 fw-bold" id="statApproved" style="margin: 0;">0</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Container -->
    <div class="container" style="max-width: 950px; margin: 0 auto;">
        @using (Html.BeginForm("FinalExamScheduleApprovedbyPrincipal", "Exam", FormMethod.Post, new { enctype = "multipart/form-data", @class = "addform", id = "ApprovedResultsectionTeacherForm" }))
        {
            <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
                <h4 class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; border-bottom: none;">
                    <span>&#x2795;</span> Approved Final Exam Schedule - Principal
                </h4>
            </div>

            <input type="hidden" id="examresultserial" name="ExamResultSerial" />

            <!-- 2-Column Form Grid -->
            <div class="form-grid-container">
                <div class="form-group">
                    <label for="year">Year:</label>
                    @Html.DropDownList("Year", (SelectList)ViewBag.Years, "--Select Year--", new { @class = "form-control", @id = "year", required = "required" })
                </div>
                <div class="form-group">
                    <label for="batchserial">Batch:</label>
                    <select id="batchserial" class="form-control" name="BatchSerial" required>
                        <option value="0">All</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="termserial">Term:</label>
                    <select id="termserial" class="form-control" name="TermSerial" required>
                        <option value="">-- Select Term --</option>
                        @foreach (var term in terms)
                        {
                            <option value="@term.TermSerial">@term.TermName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="examserial">Exam:</label>
                    <select id="examserial" class="form-control" name="ExamSerial" required>
                        <option value="">-- Select Exam --</option>
                    </select>
                </div>
            </div>

            <!-- Single Row Action Buttons -->
            <div class="actions-row">
                <button type="button" class="btn-custom" style="background-color: #3b82f6; color: white;" onclick="searchStudents()">Search</button>
                <button type="submit" id="approveBtn" class="btn-custom" style="background-color: #10b981; color: white;">Approve All</button>
                <button type="button" class="btn-custom" style="background-color: #ef4444; color: white;" onclick="resetForm()">Cancel</button>
            </div>

            <!-- Dynamic Students / Schedule Grid -->
            <div id="studentsGrid" class="mt-4"></div>
        }
    </div>

    @if (TempData["Message"] != null)
    {
        <script>
            window.onload = function () {
                var toastLive = document.getElementById('liveToast');
                if (toastLive) {
                    var toast = new bootstrap.Toast(toastLive);
                    toast.show();
                }
            };
        </script>
    }

    @section Scripts {
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script>
            $(document).ready(function () {
                $('#year').change(function () {
                    loadbatches();
                });

                $('#termserial').change(function () {
                    loadExam();
                });

                function loadbatches() {
                    var year = $('#year').val();
                    if (year) {
                        $.ajax({
                            url: '/Exam/GetBatchesByYearBothStatus',
                            type: 'GET',
                            data: { year: year },
                            success: function (data) {
                                var batchDropdown = $('#batchserial');
                                batchDropdown.empty().append('<option value="0">All</option>');
                                $.each(data, function (i, batch) {
                                    batchDropdown.append('<option value="' + batch.Value + '">' + batch.Text + '</option>');
                                });
                            },
                            error: function (xhr, status, error) {
                                console.error("Error loading batches:", error);
                            }
                        });
                    }
                }

                function loadExam() {
                    var termserial = $('#termserial').val();
                    if (termserial) {
                        $.ajax({
                            url: '/Exam/GetExamsAllActivePendingOnlyFinal',
                            type: 'GET',
                            data: { termserial: termserial },
                            success: function (data) {
                                var examDropdown = $('#examserial');
                                examDropdown.empty().append('<option value="">-- Select Exam --</option>');
                                $.each(data, function (i, item) {
                                    examDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                                });
                            }
                        });
                    }
                }
            });

            function searchStudents() {
                var year = $('#year').val();
                var batchserial = $('#batchserial').val();
                var termserial = $('#termserial').val();
                var examserial = $('#examserial').val();

                if (!year || batchserial === "" || !termserial || !examserial) {
                    alert("Please select all required filter fields.");
                    return;
                }

                $.ajax({
                    url: '/Exam/SearchFinalExamScheduleApprovedbyPrincipal',
                    type: 'GET',
                    data: {
                        year: year,
                        batchserial: batchserial,
                        termserial: termserial,
                        examserial: examserial
                    },
                    success: function (data) {
                        var html = '';

                        if (data && data.length > 0) {
                            html += '<div class="addtable-container border-0 shadow-sm p-4 bg-white rounded-4">';
                            html += '<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">';
                            html += '<h4 class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a;">&#x23F3;Final Exams Pending Principal Approval</h4>';
                            html += '<div class="position-relative" style="max-width: 300px; width: 100%;">';
                            html += '<input type="text" id="gridSearch" class="form-control filter-control" placeholder=ç Search results..." onkeyup="filterGridTable()" style="height: 38px; font-size: 14px; border-radius: 8px;" />';
                            html += '</div></div>';

                            html += '<div class="table-responsive"><table class="table addtable align-middle" id="approvalTable">';
                            html += '<thead><tr><th style="display:none;">Exam Schedule Serial</th><th>Year</th><th>Batch Name</th><th>Term Name</th><th>Exam Name</th><th>Subject</th><th>Date & Time</th><th>Status</th><th>Approved - Principal</th><th>Action</th></tr></thead>';
                            html += '<tbody>';

                            for (var i = 0; i < data.length; i++) {
                                var approvedStatus = data[i].ApprovedByPrincipal || "";

                                html += '<tr>';
                                html += '<td style="display:none;"><input type="hidden" name="ExamScheduleSerials" value="' + data[i].ExamScheduleSerial + '" /></td>';
                                html += '<td>' + data[i].Year + '</td>';
                                html += '<td>' + data[i].BatchName + '</td>';
                                html += '<td>' + data[i].TermName + '</td>';
                                html += '<td>' + data[i].ExamName + '</td>';
                                html += '<td>' + data[i].SubjectName + '</td>';

                                var dt;
                                if (typeof data[i].DateTime === 'string' && data[i].DateTime.indexOf('/Date(') > -1) {
                                    let timestamp = parseInt(data[i].DateTime.replace(/[^0-9]/g, ""));
                                    dt = new Date(timestamp);
                                } else {
                                    dt = new Date(data[i].DateTime);
                                }

                                var formattedDateTime = dt.getFullYear() + '-' +
                                    String(dt.getMonth() + 1).padStart(2, '0') + '-' +
                                    String(dt.getDate()).padStart(2, '0') + ' ' +
                                    String(dt.getHours()).padStart(2, '0') + ':' +
                                    String(dt.getMinutes()).padStart(2, '0');

                                html += '<td>' + formattedDateTime + '</td>';
                                html += '<td><span class="status-badge badge-pending">' + data[i].Status + '</span></td>';
                                
                                if (approvedStatus.toLowerCase() === 'approved' || approvedStatus.toLowerCase() === 'yes' || approvedStatus.toLowerCase() === 'true') {
                                    html += '<td class="approval-status-cell"><span class="status-badge badge-approved">Approved</span></td>';
                                    html += '<td class="action-cell"><span class="text-success fw-semibold" style="font-size: 13px;">‚úì Approved</span></td>';
                                } else {
                                    html += '<td class="approval-status-cell"><span class="status-badge badge-pending">' + (approvedStatus || "Pending Approval") + '</span></td>';
                                    html += '<td class="action-cell"><button type="button" class="row-approve-btn" onclick="approveIndividual(\'' + data[i].ExamScheduleSerial + '\', this)">Approve</button></td>';
                                }
                                html += '</tr>';
                            }

                            html += '</tbody></table></div></div>';
                        } else {
                            html = '<div class="addtable-container border-0 shadow-sm p-4 bg-white rounded-4 text-center py-5">';
                            html += '<div style="font-size: 40px; opacity: 0.5;">ç</div>';
                            html += '<h5 class="text-muted fw-normal mt-2">No Final Exams found matching the criteria</h5></div>';
                        }

                        $('#studentsGrid').html(html);
                        recalculateGridStats();
                        document.getElementById("studentsGrid").scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    },
                    error: function () {
                        alert("Error occurred while searching schedules.");
                    }
                });
            }

            function approveIndividual(serial, btnEl) {
                var $btn = $(btnEl);
                var $row = $btn.closest('tr');
                var $statusCell = $row.find('.approval-status-cell');
                var $actionCell = $row.find('.action-cell');

                $btn.prop('disabled', true).text('Approving...');

                $.ajax({
                    url: '/Exam/FinalExamScheduleApprovedbyPrincipal',
                    type: 'POST',
                    traditional: true,
                    data: {
                        ExamScheduleSerials: [serial]
                    },
                    success: function () {
                        $statusCell.html('<span class="status-badge badge-approved">Approved</span>');
                        $actionCell.html('<span class="text-success fw-semibold" style="font-size: 13px;">Approved</span>');
                        recalculateGridStats();
                    },
                    error: function () {
                        alert("Error occurred while approving schedule.");
                        $btn.prop('disabled', false).text('Approve');
                    }
                });
            }

            function recalculateGridStats() {
                var rows = $("#approvalTable tbody tr");
                var total = rows.length;
                var pending = 0;
                var approved = 0;

                rows.each(function () {
                    var statusText = $(this).find(".approval-status-cell").text().trim();
                    if (statusText.toLowerCase() === 'approved') {
                        approved++;
                    } else {
                        pending++;
                    }
                });

                $('#statTotalExams').text(total);
                $('#statPendingApproval').text(pending);
                $('#statApproved').text(approved);
            }

            function filterGridTable() {
                var query = $("#gridSearch").val().toLowerCase();
                $("#approvalTable tbody tr").each(function () {
                    var rowText = $(this).text().toLowerCase();
                    if (rowText.indexOf(query) > -1) {
                        $(this).removeClass("d-none");
                    } else {
                        $(this).addClass("d-none");
                    }
                });
            }

            function resetForm() {
                document.getElementById("ApprovedResultsectionTeacherForm").reset();
                $('#studentsGrid').empty();
                $('#statTotalExams').text(0);
                $('#statPendingApproval').text(0);
                $('#statApproved').text(0);
            }

            setTimeout(function () {
                const alert = document.querySelector('.alert');
                if (alert) {
                    alert.style.display = 'none';
                }
            }, 3000);
        </script>
    }
</body>
</html>

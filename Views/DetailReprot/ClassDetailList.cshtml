@{
ViewBag.Title = "ClassDetailList";
Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- ClassDetailList.cshtml content -->

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <!-- CSS -->
        <link rel="stylesheet" href="@Url.Content("~/Content/StyleSheet4.css")" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.20/dist/sweetalert2.min.css">

        <title>ClassDetailList</title>

    </head>
    <body>
            <style>
    .inline-form-row {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        align-items: flex-end !important;
        gap: 12px !important;
        margin-bottom: 1.5rem;
        width: 100%;
    }
    .inline-form-row > div {
        flex: 1 1 150px !important;
        display: flex !important;
        flex-direction: column !important;
        margin-bottom: 0 !important;
    }
    .inline-form-row .button-group-inline {
        flex: 0 0 auto !important;
        display: flex !important;
        flex-direction: row !important;
        gap: 10px !important;
        align-items: center !important;
    }
        .btn-search {
        background-color: #22c55e !important;
        color: white !important;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        box-shadow: 0 4px 6px -1px rgba(34, 197, 94, 0.2) !important;
    }
    .btn-search:hover {
        background-color: #16a34a !important;
        box-shadow: 0 10px 15px -3px rgba(34, 197, 94, 0.3) !important;
    }
    .btn-cancel {
        background-color: #ef4444 !important;
        color: white !important;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        box-shadow: 0 4px 6px -1px rgba(239, 68, 68, 0.2) !important;
    }
    .btn-cancel:hover {
        background-color: #dc2626 !important;
        box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.3) !important;
    }
        .btn-download {
        background-color: #3b82f6 !important;
        color: white !important;
        border: none !important;
        padding: 10px 40px !important;
        border-radius: 4px !important;
        box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.2) !important;
        width: 200px !important;
        min-width: 150px !important;
        display: block !important;
        font-weight: 500;
        margin: 0 auto !important;
        transition: all 0.2s ease-in-out;
    }
    .btn-download:hover {
        background-color: #2563eb !important;
        box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3) !important;
        transform: translateY(-1px);
    }
    </style>
        <!-- Form -->
        <div class="container mt-4">
            <div class="card shadow-sm">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #2c3e50, #3498db);">
                    <h4 class="mb-0"><i class="fas fa-list-alt"></i> Class Detail List</h4>
                </div>
                <div class="card-body">

                    @{
                    // Build a new list with "All" having value "0"
                    var yearsList = new List<SelectListItem>
                        {
                            new SelectListItem { Text = "All", Value = "0", Selected = true }
                            };

                            // Add existing years from ViewBag
                            yearsList.AddRange(((SelectList)ViewBag.Years).ToList());
                        }


                        @using (Html.BeginForm("ClassDetailList", "DetailReprot", FormMethod.Post, new { enctype = "multipart/form-data", @class = "addform", id = "ClassDetailListForm" }))
                        {
                            <!-- Form contents here -->
                            <div class="inline-form-row">
                                <div>
                                    <label for="yearlabel">Year:</label>
                                    @Html.DropDownList("Year", yearsList, new { @class = "form-control", @id = "year", required = "required" })
                                </div>
                                <div>
                                    <label for="batchDropdown">Batch:</label>
                                    <select id="batchserial" class="form-control" name="BatchSerial">
                                        <option value="0">All</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="claassDropdown">Class:</label>
                                    <select id="classserial" class="form-control" name="ClassSerial">
                                        <option value="0">All</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="status">Status:</label>
                                    <select id="status" class="form-control" name="Status" >
                                        <option value="o">All</option>
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                </div>
                                <div class="button-group-inline">
                                    <button type="button" class="btn-search" onclick="search()">Search</button>
                                
                            <button type="button" class="btn-cancel" onclick="location.reload();">Cancel</button>
                        </div>
                            </div>


                            <div id="studentsGrid">

                            </div>


                            <div class="form-group text-center mt-4">
                                <button type="submit" class="btn-download">Download</button>
                                
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (TempData["Message"] != null)
            {
                <script>
                    window.onload = function () {
                        var toastLive = document.getElementById('liveToast');
                        var toast = new bootstrap.Toast(toastLive);
                        toast.show();
                    };
                </script>
            }

            <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
            <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
            <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.20/dist/sweetalert2.all.min.js"></script>

            <script>
                $(document).ready(function () {
                    // log and bind year change
                    $('#year').change(function () {
                        console.log("Year changed to:", $(this).val());
                        loadbatches();
                    });

                    $('#batchserial').change(function () {
                        loadClasses();
                    });

                    //load batches
                    function loadbatches() {
                        var year = $('#year').val();

                        if (year) {
                            $.ajax({
                                url: '/DetailReprot/GetBatchesByYearBothStatus',
                                type: 'GET',
                                data: { year: year },
                                success: function (data) {
                                    console.log("Batches received:", data); // debug
                                    var batchDropdown = $('#batchserial');
                                    batchDropdown.empty();
                                    batchDropdown.append('<option value="0">All</option>');
                                    $.each(data, function (i, batch) {
                                        batchDropdown.append('<option value="' + batch.Value + '">' + batch.Text + '</option>');
                                    });
                                },
                                error: function (xhr, status, error) {
                                    console.error("Error loading batches:", error);
                                    alert('Failed to load batches.');
                                }
                            });
                        }
                    }

                    function loadClasses() {
                        var batchSerial = $('#batchserial').val();

                        if (batchSerial) {
                            $.ajax({
                                url: '/DetailReprot/GetClassesByBatchBothStatus',
                                type: 'GET',
                                data: { batchSerial: batchSerial },
                                success: function (data) {
                                    var classDropdown = $('#classserial');
                                    classDropdown.empty().append('<option value="0">All</option>');
                                    $.each(data, function (i, item) {
                                        classDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                                    });
                                }
                            });
                        }
                    }
                });

                function search() {
                    var year = $('#year').val();
                    var batchserial = $('#batchserial').val();
                    var status = $('#status').val();
                    var classserial = $('#classserial').val();

                    $.ajax({
                        url: '/DetailReprot/SearchClassDetailForPDF',
                        type: 'GET',
                        data: {
                            year: year,
                            batchserial: batchserial,
                            classserial: classserial,
                            status: status
                        },
                        success: function (data) {
                            var html = '';
                            if (data.length > 0) {
                                html += '<table id="resultTable" class="table table-striped table-hover table-bordered w-100">';
                                html += '<thead class="table-dark"><tr><th>No</th><th>Year</th><th>Batch Name</th><th>Grade</th><th>Class</th><th>Class Teacher</th><th>Status</th></tr></thead><tbody>';

                                for (var i = 0; i < data.length; i++) {
                                    html += '<tr>';
                                    html += '<td>' + data[i].No + '</td>';
                                    html += '<td>' + data[i].Year + '</td>';
                                    html += '<td>' + data[i].BatchName + '</td>';
                                    html += '<td>' + data[i].GradeName + '</td>';
                                    html += '<td>' + data[i].ClassName + '</td>';
                                    html += '<td>' + data[i].FullName + '</td>';
                                    html += '<td><span class="badge ' + (data[i].Status == 'Active' ? 'bg-success' : 'bg-danger') + '">' + data[i].Status + '</span></td>';
                                    html += '</tr>';
                                }

                                html += '</tbody></table>';

                            }
                            else
                            {
                                html = '<div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> No classes found.</div>';
                            }

                            $('#studentsGrid').html(html);

                            if (data.length > 0) {
                                $('#resultTable').DataTable({
                                    "pageLength": 10,
                                    "responsive": true,
                                    "destroy": true,
                                    "language": {
                                        "search": "_INPUT_",
                                        "searchPlaceholder": "Search records..."
                                    }
                                });
                            }
                        },

                        error: function () {
                            alert("Error occurred.");
                        }
                    });
                }
            </script>
            <script>
                setTimeout(function () {
                    const alert = document.querySelector('.alert');
                    if (alert) {
                        alert.style.display = 'none';
                    }
                }, 3000); // Hide after 3 seconds
            </script>

    </body>

</html>

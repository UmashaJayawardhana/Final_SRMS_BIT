@{
    ViewBag.Title = "Password Changed Successfully";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .success-card {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
        max-width: 580px;
        margin: 2rem auto;
        padding: 3rem 2.5rem;
        text-align: center;
    }

    .success-icon-badge {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: rgba(16, 185, 129, 0.12);
        color: #10b981;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        position: relative;
        animation: pulseBadge 2s infinite;
    }

    @@keyframes pulseBadge {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
        70% { box-shadow: 0 0 0 16px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .success-card h3 {
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 0.5rem;
        font-size: 1.6rem;
    }

    .success-card p {
        color: #64748b;
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }

    .action-btn-group {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .btn-action-custom {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        transition: all 0.25s ease;
    }

    .btn-primary-custom {
        background-color: #3b82f6;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
    }

    .btn-primary-custom:hover {
        background-color: #2563eb;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(59, 130, 246, 0.35);
    }

    .btn-secondary-custom {
        background-color: #f1f5f9;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

    .btn-secondary-custom:hover {
        background-color: #e2e8f0;
        color: #0f172a;
        transform: translateY(-1px);
    }
</style>

<div class="container-fluid px-0">
    <div class="success-card">
        <div class="success-icon-badge">
            <ion-icon name="checkmark-circle-outline"></ion-icon>
        </div>

        <h3>Password Changed!</h3>
        <p>Your account security password has been updated successfully. You can now use your new password to log in.</p>

        <div class="action-btn-group">
            <a href="/Account/ProfileChange" class="btn-action-custom btn-primary-custom">
                <ion-icon name="person-outline"></ion-icon> Return to Profile
            </a>
            <a href="/Home/Dashboard" class="btn-action-custom btn-secondary-custom">
                <ion-icon name="grid-outline"></ion-icon> Go to Dashboard
            </a>
            <a href="/Account/LogOn" class="btn-action-custom btn-secondary-custom">
                <ion-icon name="log-in-outline"></ion-icon> Log In Again
            </a>
        </div>
    </div>
</div>

@{
    ViewBag.Title = "TeacherAddToSubject";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<MvcApplication1.Models.TeacherAddToSubjectModels>

@{
    var subjects = ViewBag.Subjects as List<MvcApplication1.Models.SubjectModels> ?? new List<MvcApplication1.Models.SubjectModels>();
    var teachers = ViewBag.Teachers as List<MvcApplication1.Models.TeacherModels> ?? new List<MvcApplication1.Models.TeacherModels>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/StyleSheet4.css")" />

    <style>
        /* Scoped styling for TeacherAddToSubject enhancements */

        /* Stats Cards */
        .stat-card {
            border-radius: 12px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            background: #ffffff;
            border: 1px solid #e2e8f0;
        }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02) !important;
        }
        .bg-primary-subtle {
            background-color: rgba(59, 130, 246, 0.08) !important;
        }
        .bg-success-subtle {
            background-color: rgba(34, 197, 94, 0.08) !important;
        }

        /* Custom Grid Form Container to ensure strict 2-column layout */
        .form-grid-container {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            column-gap: 24px !important;
            row-gap: 0 !important;
        }
        @@media (max-width: 768px) {
            .form-grid-container {
                grid-template-columns: 1fr !important;
            }
        }
        /* Ensure form-group elements inside grid container align nicely */
        .form-grid-container .form-group {
            display: flex !important;
            flex-direction: column !important;
            gap: 6px !important;
            margin-bottom: 1.25rem !important;
        }

        /* Table Search and Filters */
        .filter-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
            outline: none;
        }

        /* Edit Mode dynamic classes */
        .addform.editing-state {
            border: 2px solid #8b5cf6 !important;
            box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.15), 0 8px 10px -6px rgba(139, 92, 246, 0.08) !important;
        }
        .editing-row {
            background-color: rgba(139, 92, 246, 0.06) !important;
            border-left: 4px solid #8b5cf6 !important;
        }
        .editing-row td {
            font-weight: 500;
            color: #6d28d9 !important;
        }

        /* Row selection highlight */
        .addtable tbody tr.table-active-row {
            background-color: rgba(59, 130, 246, 0.08) !important;
            border-left: 4px solid #3b82f6 !important;
        }

        /* Smooth transitions */
        .addform, .addtable tr {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
    </style>

    <title>Teacher Add To Subject</title>
</head>
<body>

    <!-- Metrics / Statistics Panel -->
    <div class="row g-3 mb-4" style="max-width: 900px; margin: 0 auto 1.5rem auto;">
        <div class="col-md-6">
            <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-3 d-flex align-items-center justify-content-center" style="font-size: 24px; width: 56px; height: 56px;">
                    <ion-icon name="book-outline"></ion-icon>
                </div>
                <div>
                    <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Total Assigned Subjects</h6>
                    <h3 class="mb-0 fw-bold" id="statTotalAssignments" style="margin: 0;">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success rounded-3 p-3 d-flex align-items-center justify-content-center" style="font-size: 24px; width: 56px; height: 56px;">
                    <ion-icon name="checkmark-circle-outline"></ion-icon>
                </div>
                <div>
                    <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Active Assignments</h6>
                    <h3 class="mb-0 fw-bold" id="statActiveAssignments" style="margin: 0;">0</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Form -->
    @using (Html.BeginForm("TeacherAddToSubject", "Teacher", FormMethod.Post, new { @class = "addform", id = "assignForm", style = "max-width: 900px;" }))
    {
        <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
            <h4 id="formHeader" class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; width: 100%; border-bottom: none;">
                <span id="formHeaderEmoji">&#x2795;</span> <span id="formHeaderText">Assign Teacher to Subject</span>
            </h4>
            <span id="formBadge" class="badge bg-purple text-white px-2 py-1" style="display: none; background-color: #8b5cf6; font-size: 11px; font-weight: 600; border-radius: 6px;">EDIT MODE</span>
        </div>

        <input type="hidden" id="teachersubjectSerial" name="TeacherSubjectSerial" />

        <div class="form-grid-container">
            <div class="form-group mb-3">
                <label for="TeacherSerial" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Teacher:</label>
                <select id="teacherDropdown" class="form-control" name="TeacherSerial" required>
                    <option value="">-- Select Teacher --</option>
                    @foreach (var teacher in teachers)
                    {
                        <option value="@teacher.TeacherSerial">@teacher.FullName</option>
                    }
                </select>
            </div>

            <div class="form-group mb-3">
                <label for="SubjectSerial" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Subject:</label>
                <select id="subjectDropdown" class="form-control" name="SubjectSerial" required>
                    <option value="">-- Select Subject --</option>
                    @foreach (var subject in subjects)
                    {
                        <option value="@subject.SubjectSerial">@subject.SubjectName</option>
                    }
                </select>
            </div>

            <div class="form-group mb-3">
                <label for="Status" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Status:</label>
                <select id="statusDropdown" class="form-control" name="Status" required>
                    <option value="">-- Select Status --</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
        </div>

        <!-- Actions Buttons -->
        <div style="display: flex !important; flex-direction: row !important; gap: 12px; justify-content: center; margin-top: 24px;">
            <button type="submit" id="saveBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #3b82f6; color: white; border: none; cursor: pointer; min-width: 110px;">Save</button>
            <button type="button" id="toggleListBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #0f172a; color: white; border: none; cursor: pointer; min-width: 110px;" onclick="toggleList();">Show List</button>
            <button type="button" id="cancelBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #ef4444 !important; color: white; border: none; cursor: pointer; min-width: 110px;" onclick="resetForm();">Cancel</button>
        </div>
    }

    <!-- Table Container -->
    <div id="listContainer" class="d-none">
        <div class="addtable-container border-0 shadow-sm p-4 bg-white rounded-4" style="max-width: 900px; margin: 1.5rem auto 3rem auto;">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
                <h4 class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; border-bottom: none; width: auto;">
                    <span style="font-size: 22px; margin-right: 2px;">&#x1F3EB;</span> Teacher - Subject Table
                </h4>
                <!-- Force search controls to the right -->
                <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end" style="margin-left: auto;">
                    <div class="position-relative flex-grow-1" style="max-width: 300px;">
                        <ion-icon name="search-outline" class="position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); font-size: 18px;"></ion-icon>
                        <input type="text" id="tableSearch" class="form-control filter-control ps-5" placeholder="Search Assignments..." style="height: 40px; font-size: 14px; border-radius: 8px;" />
                    </div>
                    <select id="statusFilter" class="form-select filter-control" style="width: 140px; height: 40px; font-size: 14px; border-radius: 8px;">
                        <option value="All">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>

            <!-- Table -->
            <table class="table addtable align-middle" id="assignmentsTable" style="margin-bottom: 0 !important;">
                <thead>
                    <tr>
                        <th style="display:none;">Serial No</th> 
                        <th>No</th>
                        <th style="display:none;">TeacherSerial</th>
                        <th>FullName</th>
                        <th style="display:none;">SubjectSerial</th>
                        <th>Subject Name</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assign in Model)
                    {
                        <tr onclick="fillForm(this)" style="cursor: pointer;">
                            <td style="display:none;" class="col-serial">@assign.TeacherSubjectSerial</td>
                            <td class="col-no">@assign.No</td>
                            <td style="display:none;" class="col-teacherserial">@assign.TeacherSerial</td>
                            <td class="col-fullname">@assign.FullName</td>
                            <td style="display:none;" class="col-subjectserial">@assign.SubjectSerial</td>
                            <td class="col-subjectname">@assign.SubjectName</td>
                            <td class="col-status">
                                @if (assign.Status == "Active")
                                {
                                    <span class="badge bg-success-subtle text-success px-2.5 py-1" style="font-size: 12px; border: 1px solid #bbf7d0; border-radius: 20px; display: inline-flex; align-items: center; gap: 4px;">
                                        <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #22c55e;"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1" style="font-size: 12px; border: 1px solid #cbd5e1; border-radius: 20px; display: inline-flex; align-items: center; gap: 4px;">
                                        <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #64748b;"></span> Inactive
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Empty State -->
            <div id="emptyState" class="text-center py-5 d-none">
                <ion-icon name="search-outline" class="text-muted mb-2" style="font-size: 40px; opacity: 0.5;"></ion-icon>
                <h5 class="text-muted fw-normal" style="font-size: 16px;">No matching assignments found</h5>
            </div>
        </div>
    </div>

    <!-- Scripts Section -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Update stats on load
        function calculateStats() {
            var rows = document.querySelectorAll("#assignmentsTable tbody tr");
            var total = rows.length;
            var active = 0;

            rows.forEach(function (row) {
                var statusText = row.querySelector(".col-status").innerText.trim().toLowerCase();
                if (statusText.indexOf("active") > -1 && statusText.indexOf("inactive") === -1) {
                    active++;
                }
            });

            document.getElementById("statTotalAssignments").innerText = total;
            document.getElementById("statActiveAssignments").innerText = active;
        }

        $(document).ready(function () {
            calculateStats();

            // Set up search and filter listeners
            $("#tableSearch").on("keyup input", filterTable);
            $("#statusFilter").on("change", filterTable);

            // Clean up alert banners after 3 seconds
            setTimeout(function () {
                const alert = document.querySelector('.alert');
                if (alert) {
                    alert.style.display = 'none';
                }
            }, 3000);
            // Check for TempData message and show toast
        @if (TempData["Message"] != null)
        {
         <text>
            var toastLive = document.getElementById('liveToast');
            if (toastLive) {
                var toast = new bootstrap.Toast(toastLive);
                toast.show();
            }
            </text>
        }
        });

        // Toggle Teacher Table List visibility
        function toggleList() {
            var container = document.getElementById("listContainer");
            var btn = document.getElementById("toggleListBtn");
            if (container.classList.contains("d-none")) {
                container.classList.remove("d-none");
                btn.innerText = "Hide List";
                btn.style.backgroundColor = "#475569";
                container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                container.classList.add("d-none");
                btn.innerText = "Show List";
                btn.style.backgroundColor = "#0f172a";
            }
        }

        // Search & Filter functionality
        function filterTable() {
            var searchQuery = $("#tableSearch").val().toLowerCase();
            var statusFilter = $("#statusFilter").val();
            var visibleRows = 0;

            $("#assignmentsTable tbody tr").each(function () {
                var row = $(this);
                var fullName = row.find(".col-fullname").text().trim().toLowerCase();
                var subjectName = row.find(".col-subjectname").text().trim().toLowerCase();
                var statusText = row.find(".col-status").text().trim().toLowerCase();

                var isActive = statusText.indexOf("active") > -1 && statusText.indexOf("inactive") === -1;
                var isInactive = statusText.indexOf("inactive") > -1;

                var matchesSearch = fullName.indexOf(searchQuery) > -1 || subjectName.indexOf(searchQuery) > -1;

                var matchesStatus = true;
                if (statusFilter === "Active") {
                    matchesStatus = isActive;
                } else if (statusFilter === "Inactive") {
                    matchesStatus = isInactive;
                }

                if (matchesSearch && matchesStatus) {
                    row.removeClass("d-none");
                    visibleRows++;
                } else {
                    row.addClass("d-none");
                }
            });

            if (visibleRows === 0) {
                $("#emptyState").removeClass("d-none");
                $("#assignmentsTable").addClass("d-none");
            } else {
                $("#emptyState").addClass("d-none");
                $("#assignmentsTable").removeClass("d-none");
            }
        }

        // Fill Form for editing
        function fillForm(row) {
            $("#assignmentsTable tbody tr").removeClass("editing-row table-active-row");
            $(row).addClass("editing-row table-active-row");

            var serial = $(row).find(".col-serial").text().trim();
            var teacherSerial = $(row).find(".col-teacherserial").text().trim();
            var fullName = $(row).find(".col-fullname").text().trim();
            var subjectSerial = $(row).find(".col-subjectserial").text().trim();
            var statusText = $(row).find(".col-status").text().trim();
            
            // Clean up status text check
            var status = "Active";
            if (statusText.toLowerCase().indexOf("inactive") > -1) {
                status = "Inactive";
            }

            document.getElementById("teachersubjectSerial").value = serial;
            document.getElementById("teacherDropdown").value = teacherSerial;
            document.getElementById("subjectDropdown").value = subjectSerial;
            document.getElementById("statusDropdown").value = status;

            // Update UI to edit state
            $("#assignForm").addClass("editing-state");
            document.getElementById("formHeaderEmoji").innerHTML = "&#x270F;";
            document.getElementById("formHeaderText").innerHTML = "Edit Assignment: " + fullName;
            $("#formBadge").fadeIn(200);

            // Adjust save button
            $("#saveBtn").text("Update Assignment").css("background-color", "#8b5cf6").css("border-color", "#8b5cf6");

            // Scroll form gently into view
            document.getElementById("assignForm").scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // Reset Form dynamically
        function resetForm() {
            document.getElementById("teachersubjectSerial").value = "";
            document.getElementById("assignForm").reset();

            $("#assignmentsTable tbody tr").removeClass("editing-row table-active-row");
            $("#assignForm").removeClass("editing-state");
            document.getElementById("formHeaderEmoji").innerHTML = "&#x2795;";
            document.getElementById("formHeaderText").innerHTML = "Assign Teacher to Subject";
            $("#formBadge").fadeOut(200);

            $("#saveBtn").text("Save").css("background-color", "#3b82f6").css("border-color", "#3b82f6");
        }
    </script>
</body>
</html>

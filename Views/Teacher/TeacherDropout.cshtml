@{
    ViewBag.Title = "TeacherDropout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<MvcApplication1.Models.TeacherDropoutModels>

@{
    var teachers = ViewBag.Teachers as List<MvcApplication1.Models.TeacherModels> ?? new List<MvcApplication1.Models.TeacherModels>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/StyleSheet4.css")" />

    <style>
        /* Scoped styling for TeacherDropout enhancements */

        /* Stats Cards */
        .stat-card {
            border-radius: 12px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            background: #ffffff;
            border: 1px solid #e2e8f0;
        }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02) !important;
        }
        .bg-primary-subtle {
            background-color: rgba(59, 130, 246, 0.08) !important;
        }
        .bg-success-subtle {
            background-color: rgba(34, 197, 94, 0.08) !important;
        }

        /* Custom Grid Form Container to ensure strict 2-column layout */
        .form-grid-container {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            column-gap: 24px !important;
            row-gap: 0 !important;
        }
        @@media (max-width: 768px) {
            .form-grid-container {
                grid-template-columns: 1fr !important;
            }
        }
        /* Ensure form-group elements inside grid container align nicely */
        .form-grid-container .form-group {
            display: flex !important;
            flex-direction: column !important;
            gap: 6px !important;
            margin-bottom: 1.25rem !important;
        }

        /* Table Search and Filters */
        .filter-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
            outline: none;
        }

        /* Edit Mode dynamic classes */
        .addform.editing-state {
            border: 2px solid #8b5cf6 !important;
            box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.15), 0 8px 10px -6px rgba(139, 92, 246, 0.08) !important;
        }
        .editing-row {
            background-color: rgba(139, 92, 246, 0.06) !important;
            border-left: 4px solid #8b5cf6 !important;
        }
        .editing-row td {
            font-weight: 500;
            color: #6d28d9 !important;
        }

        /* Row selection highlight */
        .addtable tbody tr.table-active-row {
            background-color: rgba(59, 130, 246, 0.08) !important;
            border-left: 4px solid #3b82f6 !important;
        }

        /* Smooth transitions */
        .addform, .addtable tr {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
    </style>

    <title>Teacher Dropout</title>
</head>
<body>

    <!-- Metrics / Statistics Panel -->
    <div class="row g-3 mb-4" style="max-width: 900px; margin: 0 auto 1.5rem auto;">
        <div class="col-md-12">
            <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3" style="max-width: 440px; margin: 0 auto;">
                <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-3 d-flex align-items-center justify-content-center" style="font-size: 24px; width: 56px; height: 56px;">
                    <ion-icon name="log-out-outline"></ion-icon>
                </div>
                <div>
                    <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Total Dropout Teachers</h6>
                    <h3 class="mb-0 fw-bold" id="statTotalDropouts" style="margin: 0;">0</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Form -->
    @using (Html.BeginForm("TeacherDropout", "Teacher", FormMethod.Post, new { @class = "addform", id = "assignForm", onsubmit = "return validateDates();", style = "max-width: 900px;" }))
    {
        <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
            <h4 id="formHeader" class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; width: 100%; border-bottom: none;">
                <span id="formHeaderEmoji">&#x2795;</span> <span id="formHeaderText">Teacher Dropout</span>
            </h4>
            <span id="formBadge" class="badge bg-purple text-white px-2 py-1" style="display: none; background-color: #8b5cf6; font-size: 11px; font-weight: 600; border-radius: 6px;">EDIT MODE</span>
        </div>

        <input type="hidden" id="teacherdropoutSerial" name="TeacherDropoutSerial" />

        <div class="form-grid-container">
            <div class="form-group mb-3">
                <label for="TeacherSerial" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Teacher:</label>
                <select id="teacherDropdown" class="form-control" name="TeacherSerial" required>
                    <option value="">-- Select Teacher --</option>
                    @foreach (var teacher in teachers)
                    {
                        <option value="@teacher.TeacherSerial">@teacher.FullName</option>
                    }
                </select>
            </div>

            <div class="form-group mb-3">
                <label for="DropoutReason" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Reason:</label>
                <input type="text" id="dropoutReason" name="DropoutReason" required placeholder="Dropout Reason">
            </div>

            <div class="form-group mb-3">
                <label for="DropoutDate" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Date:</label>
                <input type="date" id="dropoutDate" name="DropoutDate" required class="form-control">
            </div>
        </div>

        <!-- Actions Buttons -->
        <div style="display: flex !important; flex-direction: row !important; gap: 12px; justify-content: center; margin-top: 24px;">
            <button type="submit" id="saveBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #3b82f6; color: white; border: none; cursor: pointer; min-width: 110px;">Dropout</button>
            <button type="button" id="toggleListBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #0f172a; color: white; border: none; cursor: pointer; min-width: 110px;" onclick="toggleList();">Show List</button>
            <button type="button" id="cancelBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #ef4444 !important; color: white; border: none; cursor: pointer; min-width: 110px;" onclick="resetForm();">Cancel</button>
        </div>
    }

    <!-- Table Container -->
    <div id="listContainer" class="d-none">
        <div class="addtable-container border-0 shadow-sm p-4 bg-white rounded-4" style="max-width: 900px; margin: 1.5rem auto 3rem auto;">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
                <h4 class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; border-bottom: none; width: auto;">
                    <span style="font-size: 22px; margin-right: 2px;">&#x1F3EB;</span> Teacher - Dropout Table
                </h4>
                <!-- Force search controls to the right -->
                <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end" style="margin-left: auto;">
                    <div class="position-relative flex-grow-1" style="max-width: 300px;">
                        <ion-icon name="search-outline" class="position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); font-size: 18px;"></ion-icon>
                        <input type="text" id="tableSearch" class="form-control filter-control ps-5" placeholder="Search Dropouts..." style="height: 40px; font-size: 14px; border-radius: 8px;" />
                    </div>
                </div>
            </div>

            <!-- Table -->
            <table class="table addtable align-middle" id="dropoutTable" style="margin-bottom: 0 !important;">
                <thead>
                    <tr>
                        <th style="display:none;">Serial No</th> 
                        <th>No</th>
                        <th style="display:none;">TeacherSerial</th>
                        <th>FullName</th>
                        <th>Dropout Reason</th>
                        <th>Dropout Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dropout in Model)
                    {
                        <tr onclick="fillForm(this)" style="cursor: pointer;">
                            <td style="display:none;" class="col-serial">@dropout.TeacherDropoutSerial</td>
                            <td class="col-no">@dropout.No</td>
                            <td style="display:none;" class="col-teacherserial">@dropout.TeacherSerial</td>
                            <td class="col-fullname">@dropout.FullName</td>
                            <td class="col-reason">@dropout.DropoutReason</td>
                            <td class="col-date">@dropout.DropoutDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Empty State -->
            <div id="emptyState" class="text-center py-5 d-none">
                <ion-icon name="search-outline" class="text-muted mb-2" style="font-size: 40px; opacity: 0.5;"></ion-icon>
                <h5 class="text-muted fw-normal" style="font-size: 16px;">No matching dropouts found</h5>
            </div>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <script>
            window.onload = function () {
                var toastLive = document.getElementById('liveToast');
                if (toastLive) {
                    var toast = new bootstrap.Toast(toastLive);
                    toast.show();
                }
            };
        </script>
    }

    <!-- Scripts Section -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Update stats on load
        function calculateStats() {
            var rows = document.querySelectorAll("#dropoutTable tbody tr");
            document.getElementById("statTotalDropouts").innerText = rows.length;
        }

        $(document).ready(function () {
            calculateStats();

            // Set up search listener
            $("#tableSearch").on("keyup input", filterTable);

            // Clean up alert banners after 3 seconds
            setTimeout(function () {
                const alert = document.querySelector('.alert');
                if (alert) {
                    alert.style.display = 'none';
                }
            }, 3000);
        });

        // Toggle Teacher Table List visibility
        function toggleList() {
            var container = document.getElementById("listContainer");
            var btn = document.getElementById("toggleListBtn");
            if (container.classList.contains("d-none")) {
                container.classList.remove("d-none");
                btn.innerText = "Hide List";
                btn.style.backgroundColor = "#475569";
                container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                container.classList.add("d-none");
                btn.innerText = "Show List";
                btn.style.backgroundColor = "#0f172a";
            }
        }

        // Search & Filter functionality
        function filterTable() {
            var searchQuery = $("#tableSearch").val().toLowerCase();
            var visibleRows = 0;

            $("#dropoutTable tbody tr").each(function () {
                var row = $(this);
                var fullName = row.find(".col-fullname").text().trim().toLowerCase();
                var reason = row.find(".col-reason").text().trim().toLowerCase();

                var matchesSearch = fullName.indexOf(searchQuery) > -1 || reason.indexOf(searchQuery) > -1;

                if (matchesSearch) {
                    row.removeClass("d-none");
                    visibleRows++;
                } else {
                    row.addClass("d-none");
                }
            });

            if (visibleRows === 0) {
                $("#emptyState").removeClass("d-none");
                $("#dropoutTable").addClass("d-none");
            } else {
                $("#emptyState").addClass("d-none");
                $("#dropoutTable").removeClass("d-none");
            }
        }

        // Fill Form for editing
        function fillForm(row) {
            $("#dropoutTable tbody tr").removeClass("editing-row table-active-row");
            $(row).addClass("editing-row table-active-row");

            var serial = $(row).find(".col-serial").text().trim();
            var teacherSerial = $(row).find(".col-teacherserial").text().trim();
            var fullName = $(row).find(".col-fullname").text().trim();
            var reason = $(row).find(".col-reason").text().trim();
            var date = $(row).find(".col-date").text().trim();

            document.getElementById("teacherdropoutSerial").value = serial;
            document.getElementById("teacherDropdown").value = teacherSerial;
            document.getElementById("dropoutReason").value = reason;
            document.getElementById("dropoutDate").value = date;

            // Update UI to edit state
            $("#assignForm").addClass("editing-state");
            document.getElementById("formHeaderEmoji").innerHTML = "&#x270F;";
            document.getElementById("formHeaderText").innerHTML = "Edit Dropout: " + fullName;
            $("#formBadge").fadeIn(200);

            // Adjust save button
            $("#saveBtn").text("Update Dropout").css("background-color", "#8b5cf6").css("border-color", "#8b5cf6");

            // Scroll form gently into view
            document.getElementById("assignForm").scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // Reset Form dynamically
        function resetForm() {
            document.getElementById("teacherdropoutSerial").value = "";
            document.getElementById("assignForm").reset();

            $("#dropoutTable tbody tr").removeClass("editing-row table-active-row");
            $("#assignForm").removeClass("editing-state");
            document.getElementById("formHeaderEmoji").innerHTML = "&#x2795;";
            document.getElementById("formHeaderText").innerHTML = "Teacher Dropout";
            $("#formBadge").fadeOut(200);

            $("#saveBtn").text("Dropout").css("background-color", "#3b82f6").css("border-color", "#3b82f6");
        }

        // Validate date
        function validateDates() {
            var today = new Date().toISOString().split("T")[0];
            var dropoutDate = document.getElementById("dropoutDate").value;

            if (dropoutDate > today) {
                alert("Dropout Date cannot be in the future.");
                return false;
            }

            return true;
        }
    </script>
</body>
</html>

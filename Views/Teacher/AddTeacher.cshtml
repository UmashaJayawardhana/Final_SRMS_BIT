@{
    ViewBag.Title = "AddTeacher";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<MvcApplication1.Models.TeacherModels>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/StyleSheet4.css")" />

    <style>
        /* Scoped styling for AddTeacher enhancements */

        /* Stats Cards */
        .stat-card {
            border-radius: 12px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            background: #ffffff;
            border: 1px solid #e2e8f0;
        }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02) !important;
        }
        .bg-primary-subtle {
            background-color: rgba(59, 130, 246, 0.08) !important;
        }
        .bg-success-subtle {
            background-color: rgba(34, 197, 94, 0.08) !important;
        }

        /* Custom Grid Form Container to ensure strict 2-column layout */
        .form-grid-container {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            column-gap: 24px !important;
            row-gap: 0 !important;
        }
        @@media (max-width: 768px) {
            .form-grid-container {
                grid-template-columns: 1fr !important;
            }
        }
        /* Ensure form-group elements inside grid container align nicely */
        .form-grid-container .form-group {
            display: flex !important;
            flex-direction: column !important;
            gap: 6px !important;
            margin-bottom: 1.25rem !important;
        }

        /* Table Search and Filters */
        .filter-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
            outline: none;
        }

        /* Edit Mode dynamic classes */
        .addform.editing-state {
            border: 2px solid #8b5cf6 !important;
            box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.15), 0 8px 10px -6px rgba(139, 92, 246, 0.08) !important;
        }
        .editing-row {
            background-color: rgba(139, 92, 246, 0.06) !important;
            border-left: 4px solid #8b5cf6 !important;
        }
        .editing-row td {
            font-weight: 500;
            color: #6d28d9 !important;
        }

        /* Row selection highlight */
        .addtable tbody tr.table-active-row {
            background-color: rgba(59, 130, 246, 0.08) !important;
            border-left: 4px solid #3b82f6 !important;
        }

        /* Smooth transitions */
        .addform, .addtable tr {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
    </style>

    <title>Add Teacher</title>
</head>
<body>

    <!-- Metrics / Statistics Panel -->
    <div class="row g-3 mb-4" style="max-width: 900px; margin: 0 auto 1.5rem auto;">
        <div class="col-md-6">
            <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-3 d-flex align-items-center justify-content-center" style="font-size: 24px; width: 56px; height: 56px;">
                    <ion-icon name="people-outline"></ion-icon>
                </div>
                <div>
                    <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Total Teachers</h6>
                    <h3 class="mb-0 fw-bold" id="statTotalTeachers" style="margin: 0;">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card stat-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success rounded-3 p-3 d-flex align-items-center justify-content-center" style="font-size: 24px; width: 56px; height: 56px;">
                    <ion-icon name="checkmark-circle-outline"></ion-icon>
                </div>
                <div>
                    <h6 class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; margin: 0;">Active Teachers</h6>
                    <h3 class="mb-0 fw-bold" id="statActiveTeachers" style="margin: 0;">0</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Form -->
    @using (Html.BeginForm("AddTeacher", "Teacher", FormMethod.Post, new { enctype = "multipart/form-data", @class = "addform", id = "addTeacherForm", onsubmit = "return validateDates();", style = "max-width: 900px;" }))
    {
        <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
            <h4 id="formHeader" class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; width: 100%; border-bottom: none;">
                <span id="formHeaderEmoji">&#x2795;</span> <span id="formHeaderText">Register New Teacher</span>
            </h4>
            <span id="formBadge" class="badge bg-purple text-white px-2 py-1" style="display: none; background-color: #8b5cf6; font-size: 11px; font-weight: 600; border-radius: 6px;">EDIT MODE</span>
        </div>

        <input type="hidden" id="teacherserial" name="TeacherSerial" />

        <!-- Teacher Image Preview -->
        <div style="display: flex; justify-content: center; margin-bottom: 20px;">
            <img id="teacherImage" src="" alt="Teacher Image" style="width: 150px; height: 150px; display: none; border-radius: 12px; border: 2px solid #e2e8f0; object-fit: cover;" />
        </div>

        <div class="form-grid-container">
            <div class="form-group mb-3">
                <label for="RegNo" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Reg No:</label>
                <input type="text" id="regno" name="RegNo" value="@ViewBag.RegNo" readonly style="background-color: #e2e8f0;">
            </div>

            <div class="form-group mb-3">
                <label for="Status" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Status:</label>
                <select id="status" name="Status" required>
                    <option value="">--Select Status--</option>
                    <option value="Active">Active</option>
                    @*<option value="Inactive">Inactive</option>
                    <option value="Dropout">Dropout</option>*@
                </select>
            </div>

            <div class="form-group mb-3">
                <label for="FirstName" style="font-weight: 600; color: #475569; margin-bottom: 6px;">First Name:</label>
                <input type="text" id="firstname" name="FirstName" required placeholder="First Name">
            </div>

            <div class="form-group mb-3">
                <label for="LastName" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Last Name:</label>
                <input type="text" id="lastname" name="LastName" required placeholder="Last Name">
            </div>

            <div class="form-group mb-3">
                <label for="Initials" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Initials:</label>
                <input type="text" id="initials" name="Initials" required placeholder="e.g. A.B.">
            </div>

            <div class="form-group mb-3">
                <label for="FullName" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Full Name:</label>
                <input type="text" id="fullname" name="FullName" required placeholder="Full Name">
            </div>

            <div class="form-group mb-3">
                <label for="Gender" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Gender:</label>
                <select id="gender" name="Gender" required>
                    <option value="">--Select Gender--</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label for="DateofBirth" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Date of Birth:</label>
                <input type="date" id="dateofbirth" name="DateofBirth" required class="form-control">
            </div>

            <div class="form-group mb-3">
                <label for="NIC" style="font-weight: 600; color: #475569; margin-bottom: 6px;">NIC:</label>
                <input type="text" id="nic" name="NIC" required placeholder="NIC Number">
            </div>

            <div class="form-group mb-3">
                <label for="TelePhone" style="font-weight: 600; color: #475569; margin-bottom: 6px;">TelePhone No:</label>
                <input type="text" id="telePhone" name="TelePhone" required placeholder="10-digit Phone Number">
            </div>

            <div class="form-group mb-3">
                <label for="AdmissionDate" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Register Date:</label>
                <input type="date" id="registerdate" name="RegisterDate" required class="form-control">
            </div>

            <div class="form-group mb-3">
                <label for="UserGroupSerial" style="font-weight: 600; color: #475569; margin-bottom: 6px;">User Group:</label>
                <select id="userGroupSerial" name="UserGroupSerial" required>
                    <option value="">--Select User Group--</option>
                    <option value="1">Admin</option>
                    <option value="4">Principal</option>
                    <option value="2">Teacher</option>
                    <option value="6">Staff Member</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label style="font-weight: 600; color: #475569; margin-bottom: 6px;">User Account:</label>
                <div class="d-flex align-items-center gap-2 p-2 border rounded-3 bg-light" style="height: 44px;">
                    <input type="checkbox" id="createUserAccount" name="CreateUserAccount" value="true" style="width: 18px; height: 18px; cursor: pointer; accent-color: #3b82f6;" />
                    <label for="createUserAccount" style="font-weight: 600; color: #1e293b; cursor: pointer; margin: 0; font-size: 13.5px;">Create User Account</label>
                </div>
            </div>

            <div class="form-group mb-3">
                <label for="Image" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Image:</label>
                <input type="file" id="image" name="Photo" class="form-control" />
            </div>
        </div>

        <!-- Actions Buttons -->
        <div style="display: flex !important; flex-direction: row !important; gap: 12px; justify-content: center; margin-top: 24px;">
            <button type="submit" id="saveBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #3b82f6; color: white; border: none; cursor: pointer; min-width: 110px;">Save</button>
            <button type="button" id="toggleListBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #0f172a; color: white; border: none; cursor: pointer; min-width: 110px;" onclick="toggleTeacherList();">Show List</button>
            <button type="button" id="cancelBtn" style="height: 44px; padding: 0 24px; font-weight: 600; border-radius: 10px; background-color: #ef4444 !important; color: white; border: none; cursor: pointer; min-width: 110px;" onclick="resetTeacherForm();">Cancel</button>
        </div>
    }

    <!-- Search and Filter Bar Container -->
    <div id="teachersTableContainer" class="d-none">
        <div class="addtable-container border-0 shadow-sm p-4 bg-white rounded-4" style="max-width: 900px; margin: 1.5rem auto 3rem auto;">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
                <h4 class="m-0 border-0 p-0 d-flex align-items-center gap-2" style="font-size: 18px; font-weight: 700; color: #0f172a; border-bottom: none; width: auto;">
                    <span style="font-size: 22px; margin-right: 2px;">&#x1F3EB;</span> Teacher List
                </h4>
                <!-- Force search controls to the right -->
                <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end" style="margin-left: auto;">
                    <div class="position-relative flex-grow-1" style="max-width: 300px;">
                        <ion-icon name="search-outline" class="position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); font-size: 18px;"></ion-icon>
                        <input type="text" id="tableSearch" class="form-control filter-control ps-5" placeholder="Search Teachers..." style="height: 40px; font-size: 14px; border-radius: 8px;" />
                    </div>
                    <select id="statusFilter" class="form-select filter-control" style="width: 140px; height: 40px; font-size: 14px; border-radius: 8px;">
                        <option value="All">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Dropout">Dropout</option>
                    </select>
                </div>
            </div>

            <!-- Table -->
            <table class="table addtable align-middle" id="teachersTable" style="margin-bottom: 0 !important;">
                <thead>
                    <tr>
                        <th style="width: 60px;">No</th>
                        <th style="display: none;">Serial No</th>
                        <th>Reg No</th>
                        <th>Full Name</th>
                        <th>Gender</th>
                        <th>NIC</th>
                        <th>Phone</th>
                        <th>User Group</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var teacher in Model)
                        {
                            <tr onclick="fillTeacherForm(this)" style="cursor: pointer;">
                                 <td style="display: none;" class="col-serial">@teacher.TeacherSerial</td>
                                <td class="col-no">@teacher.No</td>
                                <td class="col-regno fw-semibold text-dark">@teacher.RegNo</td>
                                <td class="col-fullname">@teacher.FullName</td>
                                <td class="col-gender">@teacher.Gender</td>
                                <td class="col-nic">@teacher.NIC</td>
                                <td class="col-phone text-muted">@teacher.TelePhone</td>
                                <td class="col-usergroup">@teacher.UserGroupName</td>
                                <td class="col-status">
                                    @if (teacher.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success px-2.5 py-1" style="font-size: 12px; border: 1px solid #bbf7d0; border-radius: 20px; display: inline-flex; align-items: center; gap: 4px;">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #22c55e;"></span> Active
                                        </span>
                                    }
                                    else if (teacher.Status == "Inactive")
                                {
                                    <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1" style="font-size: 12px; border: 1px solid #cbd5e1; border-radius: 20px; display: inline-flex; align-items: center; gap: 4px;">
                                        <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #64748b;"></span> Inactive
                                    </span>
                                }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning px-2.5 py-1" style="font-size: 12px; border: 1px solid #cbd5e1; border-radius: 20px; display: inline-flex; align-items: center; gap: 4px;">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #eab308;"></span> Dropout
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- Empty State -->
            <div id="emptyState" class="text-center py-5 d-none">
                <ion-icon name="search-outline" class="text-muted mb-2" style="font-size: 40px; opacity: 0.5;"></ion-icon>
                <h5 class="text-muted fw-normal" style="font-size: 16px;">No matching teachers found</h5>
            </div>
        </div>
    </div>

    <!-- Scripts Section -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Toggle Teacher Table List visibility
        function toggleTeacherList() {
            var container = $("#teachersTableContainer");
            var btn = $("#toggleListBtn");
            if (container.hasClass("d-none")) {
                container.removeClass("d-none");
                btn.text("Hide List").css("background-color", "#475569");
                container[0].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                container.addClass("d-none");
                btn.text("Show List").css("background-color", "#0f172a");
            }
        }

        // Update stats on load
        function calculateStats() {
            var rows = document.querySelectorAll("#teachersTable tbody tr");
            var totalTeachers = rows.length;
            var activeTeachers = 0;

            rows.forEach(function (row) {
                var statusText = row.querySelector(".col-status").innerText.trim().toLowerCase();
                if (statusText.indexOf("active") > -1 && statusText.indexOf("inactive") === -1) {
                    activeTeachers++;
                }
            });

            document.getElementById("statTotalTeachers").innerText = totalTeachers;
            document.getElementById("statActiveTeachers").innerText = activeTeachers;
        }

        $(document).ready(function () {
            calculateStats();

            // Set up search and filter listeners
            $("#tableSearch").on("keyup input", filterTable);
            $("#statusFilter").on("change", filterTable);

            // Clean up alert banners after 3 seconds
            setTimeout(function () {
                const alert = document.querySelector('.alert');
                if (alert) {
                    alert.style.display = 'none';
                }
            }, 3000);
        

        // Check for TempData message and show toast
        @if (TempData["Message"] != null)
        {
         <text>
        var toastLive = document.getElementById('liveToast');
        if (toastLive) {
            var toast = new bootstrap.Toast(toastLive);
            toast.show();
        }
        </text>
        }
        });


        // Search & Filter functionality
        function filterTable() {
            var searchQuery = $("#tableSearch").val().toLowerCase();
            var statusFilter = $("#statusFilter").val();
            var visibleRows = 0;

            $("#teachersTable tbody tr").each(function () {
                var row = $(this);
                var regNo = row.find(".col-regno").text().trim().toLowerCase();
                var fullName = row.find(".col-fullname").text().trim().toLowerCase();
                var gender = row.find(".col-gender").text().trim().toLowerCase();
                var nic = row.find(".col-nic").text().trim().toLowerCase();
                var phone = row.find(".col-phone").text().trim().toLowerCase();
                var usergroup = row.find(".col-usergroup").text().trim().toLowerCase();
                var statusText = row.find(".col-status").text().trim().toLowerCase();

                var isActive = statusText.indexOf("active") > -1 && statusText.indexOf("inactive") === -1;
                var isInactive = statusText.indexOf("inactive") > -1;
                var isDropout = statusText.indexOf("dropout") > -1;

                var matchesSearch = regNo.indexOf(searchQuery) > -1 ||
                    fullName.indexOf(searchQuery) > -1 ||
                    gender.indexOf(searchQuery) > -1 ||
                    nic.indexOf(searchQuery) > -1 ||
                    phone.indexOf(searchQuery) > -1 ||
                    usergroup.indexOf(searchQuery) > -1;

                var matchesStatus = true;
                if (statusFilter === "Active") {
                    matchesStatus = isActive;
                }
                else if (statusFilter === "Inactive")
                {
                    matchesStatus = isInactive;
                }else if (statusFilter === "Dropout") {
                    matchesStatus = isDropout;
                }

                if (matchesSearch && matchesStatus) {
                    row.removeClass("d-none");
                    visibleRows++;
                } else {
                    row.addClass("d-none");
                }
            });

            if (visibleRows === 0) {
                $("#emptyState").removeClass("d-none");
                $("#teachersTable").addClass("d-none");
            } else {
                $("#emptyState").addClass("d-none");
                $("#teachersTable").removeClass("d-none");
            }
        }

        // Fill form helper (Edit mode trigger)
        function fillTeacherForm(row) {
            $("#teachersTable tbody tr").removeClass("editing-row table-active-row");
            $(row).addClass("editing-row table-active-row");

            var regNo = $(row).find(".col-regno").text().trim();
            var fullName = $(row).find(".col-fullname").text().trim();

            // Load details via ajax
            loadTeacherDetails(regNo);

            // Update UI to edit state
            $("#addTeacherForm").addClass("editing-state");
            document.getElementById("formHeaderEmoji").innerHTML = "&#x270F;";
            document.getElementById("formHeaderText").innerHTML = "Edit Teacher: " + fullName;
            $("#formBadge").fadeIn(200);

            // Adjust update button look
            $("#saveBtn").text("Update Teacher").css("background-color", "#8b5cf6").css("border-color", "#8b5cf6");

            // Scroll form into view gently
            document.getElementById("addTeacherForm").scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // Reset form dynamically
        function resetTeacherForm() {
            document.getElementById("teacherserial").value = "";
            document.getElementById("addTeacherForm").reset();
            $("#teacherImage").hide().attr("src", "");

            // Restore UI defaults
            $("#teachersTable tbody tr").removeClass("editing-row table-active-row");
            $("#addTeacherForm").removeClass("editing-state");
            document.getElementById("formHeaderEmoji").innerHTML = "&#x2795;";
            document.getElementById("formHeaderText").innerHTML = "Register New Teacher";
            $("#formBadge").fadeOut(200);

            // Reset button styling
            $("#saveBtn").text("Save").css("background-color", "#3b82f6").css("border-color", "#3b82f6");
        }

        // validation for dates and telephone no
        function validateDates() {
            var today = new Date().toISOString().split("T")[0];

            var dob = document.getElementById("dateofbirth").value;
            var regdate = document.getElementById("registerdate").value;
            var tele = document.getElementById("telePhone").value;
            var nicno = document.getElementById("nic").value;

            if (dob > today) {
                alert("Date of Birth cannot be in the future.");
                return false;
            }

            if (regdate > today) {
                alert("Registration Date cannot be in the future.");
                return false;
            }

            // Validate it is exactly 10 digits and all are numbers
            if (!/^\d{10}$/.test(tele)) {
                alert("Tele phone number must be exactly 10 digits.");
                return false;
            }

            if (!/^(\d{10}|\d{12})$/.test(nicno)) {
                alert("NIC number must be either 10 or 12 digits.");
                return false;
            }

            return true;
        }

        function formatDate(dotNetDateString) {
            if (!dotNetDateString) return "";
            const timestamp = parseInt(dotNetDateString.replace(/\/Date\((\d+)\)\//, "$1"));
            const date = new Date(timestamp);
            return date.toISOString().split('T')[0]; // yyyy-MM-dd
        }

        // Retrieve teacher data from reg no
        function loadTeacherDetails(regNo) {
            if (!regNo) return;

            fetch(`/Teacher/LookupTeacher?regNo=${regNo}`)
                .then(res => res.json())
                .then(data => {
                    console.log(data); // print data in console
                    
                    // Fill input fields with retrieved data
                    document.getElementById("teacherserial").value = data.TeacherSerial;
                    document.getElementById("regno").value = data.RegNo;
                    document.getElementById("firstname").value = data.FirstName;
                    document.getElementById("lastname").value = data.LastName;
                    document.getElementById("fullname").value = data.FullName;
                    document.getElementById("initials").value = data.Initials;
                    document.getElementById("gender").value = data.Gender;

                    // Format and assign dates
                    document.getElementById("dateofbirth").value = formatDate(data.DateofBirth);
                    document.getElementById("registerdate").value = formatDate(data.RegisterDate);

                    document.getElementById("nic").value = data.NIC;
                    document.getElementById("telePhone").value = data.TelePhone;
                    document.getElementById("status").value = data.Status;
                    document.getElementById("userGroupSerial").value = data.UserGroupSerial;

                    // handle photo
                    if (data.LookupPhoto) {
                        document.getElementById("teacherImage").src = data.LookupPhoto;
                        document.getElementById("teacherImage").style.display = "block";
                    } else {
                        document.getElementById("teacherImage").src = "/Content/img/profileimg.png"; // show default image
                        document.getElementById("teacherImage").style.display = "block"; 
                    }
                });
        }
    </script>
</body>
</html>

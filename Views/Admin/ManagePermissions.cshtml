@model List<MvcApplication1.Models.RolePrivilegeModel>
@{
    ViewBag.Title = "Manage Role Permissions";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roles = ViewBag.Roles as List<MvcApplication1.Models.UserGroupModels> ?? new List<MvcApplication1.Models.UserGroupModels>();
    int? selectedRoleId = ViewBag.SelectedRoleId as int?;
}

<style>
    .admin-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        margin-bottom: 2rem;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .card-header-admin {
        padding: 1.25rem 1.5rem;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .card-header-admin h5 {
        margin: 0;
        font-weight: 700;
        font-size: 1.15rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-body-admin {
        padding: 1.75rem;
    }

    .custom-input-group {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

    .custom-input-group ion-icon.input-icon {
        position: absolute;
        left: 14px;
        font-size: 1.25rem;
        color: #64748b;
        pointer-events: none;
        z-index: 5;
    }

    .custom-input-group .form-select {
        padding-left: 44px;
        height: 48px;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        font-weight: 500;
        color: #1e293b;
        background-color: #f8fafc;
        transition: all 0.2s ease;
    }

    .custom-input-group .form-select:focus {
        background-color: #ffffff;
        border-color: #3b82f6;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
    }

    .table-modern {
        width: 100%;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table-modern thead th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 12px 16px;
        border-bottom: 2px solid #e2e8f0;
    }

    .table-modern tbody td {
        padding: 14px 16px;
        border-bottom: 1px solid #e2e8f0;
        vertical-align: middle;
        font-size: 0.9rem;
    }

    /* Modern Checkbox styling */
    .checkbox-container {
        display: block;
        position: relative;
        padding-left: 30px;
        margin-bottom: 18px;
        cursor: pointer;
        font-size: 14px;
        user-select: none;
    }

    .checkbox-container input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
        height: 0;
        width: 0;
    }

    .checkmark {
        position: absolute;
        top: 0;
        left: 0;
        height: 20px;
        width: 20px;
        background-color: #f1f5f9;
        border: 2px solid #cbd5e1;
        border-radius: 6px;
        transition: all 0.2s ease;
    }

    .checkbox-container:hover input ~ .checkmark {
        background-color: #e2e8f0;
    }

    .checkbox-container input:checked ~ .checkmark {
        background-color: #3b82f6;
        border-color: #3b82f6;
    }

    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
    }

    .checkbox-container input:checked ~ .checkmark:after {
        display: block;
    }

    .checkbox-container .checkmark:after {
        left: 6px;
        top: 2px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .btn-save {
        background-color: #10b981;
        color: #ffffff;
        font-weight: 600;
        padding: 0.75rem 2rem;
        border-radius: 12px;
        border: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-save:hover {
        background-color: #059669;
        transform: translateY(-1px);
    }
</style>

<div class="container-fluid py-4" style="font-family: 'Inter', sans-serif;">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 border-0 rounded-4 p-3 mb-4 shadow-sm" role="alert" style="background-color: #ecfdf5; color: #065f46;">
            <ion-icon name="checkmark-circle-outline" style="font-size: 1.5rem;"></ion-icon>
            <div>@TempData["Message"]</div>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <!-- Role Selection Card -->
            <div class="admin-card">
                <div class="card-header-admin">
                    <h5>
                        <ion-icon name="shield-half-outline"></ion-icon>
                        <span>Role Permissions Configuration</span>
                    </h5>
                </div>
                <div class="card-body-admin">
                    @using (Html.BeginForm("ManagePermissions", "Admin", FormMethod.Get, new { id = "roleSelectionForm" }))
                    {
                        <div class="row align-items-end">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label for="roleId" style="font-weight: 600; color: #475569; margin-bottom: 6px;">Select Role (User Group)</label>
                                <div class="custom-input-group">
                                    <ion-icon name="people-outline" class="input-icon"></ion-icon>
                                    <select id="roleId" name="roleId" class="form-select" onchange="this.form.submit()">
                                        <option value="">-- Choose User Group --</option>
                                        @foreach (var role in roles)
                                        {
                                            <option value="@role.UserGroupSerial" @(selectedRoleId == role.UserGroupSerial ? "selected" : "")>@role.UserGroupName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 text-md-end text-secondary" style="font-size: 0.9rem;">
                                Select a user group to view and edit its active permissions grid.
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (selectedRoleId.HasValue)
    {
        <div class="row">
            <div class="col-12">
                @using (Html.BeginForm("SavePermissions", "Admin", FormMethod.Post))
                {
                    <input type="hidden" name="roleId" value="@selectedRoleId.Value" />

                    <div class="admin-card">
                        <div class="card-header-admin">
                            <h5>
                                <ion-icon name="lock-open-outline"></ion-icon>
                                <span>Privilege Assignment Matrix</span>
                            </h5>
                            @if (selectedRoleId.Value == 1)
                            {
                                <span class="badge bg-warning text-dark" style="font-weight: 600;">
                                    <ion-icon name="alert-circle-outline" class="align-middle"></ion-icon>
                                    Super Admin has all access by default
                                </span>
                            }
                        </div>
                        <div class="p-0">
                            <div class="table-responsive">
                                <table class="table table-modern" id="permissionsTable">
                                    <thead>
                                        <tr>
                                            <th>Page / Sub-Link</th>
                                            <th style="width: 15%; text-align: center;">View (Read)</th>
                                            <th style="width: 15%; text-align: center;">Add (Create)</th>
                                            <th style="width: 15%; text-align: center;">Edit (Update)</th>
                                            <th style="width: 15%; text-align: center;">Delete</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            var isChild = !string.IsNullOrEmpty(item.UserGroupName);
                                            <tr>
                                                <td class="@(isChild ? "ps-5 text-secondary" : "fw-bold text-dark")">
                                                    @if (isChild)
                                                    {
                                                        <ion-icon name="chevron-forward-outline" class="me-1 align-middle"></ion-icon>
                                                        <span>@item.MenuName</span>
                                                    }
                                                    else
                                                    {
                                                        <ion-icon name="folder-outline" class="me-2 align-middle text-primary"></ion-icon>
                                                        <span>@item.MenuName</span>
                                                    }
                                                </td>
                                                <td style="text-align: center;">
                                                    <label class="checkbox-container d-inline-block m-0">
                                                        <input type="checkbox" name="view_@(item.MenuId)" value="true" @(item.CanView ? "checked" : "") />
                                                        <span class="checkmark"></span>
                                                    </label>
                                                </td>
                                                <td style="text-align: center;">
                                                    <label class="checkbox-container d-inline-block m-0">
                                                        <input type="checkbox" name="add_@(item.MenuId)" value="true" @(item.CanAdd ? "checked" : "") />
                                                        <span class="checkmark"></span>
                                                    </label>
                                                </td>
                                                <td style="text-align: center;">
                                                    <label class="checkbox-container d-inline-block m-0">
                                                        <input type="checkbox" name="edit_@(item.MenuId)" value="true" @(item.CanEdit ? "checked" : "") />
                                                        <span class="checkmark"></span>
                                                    </label>
                                                </td>
                                                <td style="text-align: center;">
                                                    <label class="checkbox-container d-inline-block m-0">
                                                        <input type="checkbox" name="delete_@(item.MenuId)" value="true" @(item.CanDelete ? "checked" : "") />
                                                        <span class="checkmark"></span>
                                                    </label>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-body-admin bg-light border-top text-end">
                            <button type="submit" class="btn btn-save">
                                <ion-icon name="save-outline" style="font-size: 1.25rem;"></ion-icon>
                                Save Permissions Schema
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                const alert = document.querySelector('.alert');
                if (alert) alert.style.display = 'none';
            }, 3000);
        });
    </script>
}
